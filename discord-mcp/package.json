{
  "name": "discord-mcp",
  "version": "1.0.0",
  "description": "Discord MCP server for Digby — exposes guilds, channels, message history, posting, DMs, full-channel history scrape via bot token",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/tools/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
