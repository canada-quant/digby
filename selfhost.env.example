# Digby self-host environment — copy to .env and edit.
# Minimal viable setup: JWT secrets + ONE model provider key. Everything else
# is optional; features go dark when their keys are unset.

# ── Required ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# At least ONE model provider (chat stops working with none). Add as many as
# you have — the model lineup adapts to what's configured.
# Digby runs on FOUR open-model providers; every model call is an admin-editable
# seat (Account → Admin → Endpoints → Model roles) and any seat can point at your
# own OpenAI-compatible endpoint instead. No frontier (OpenAI / Google / xAI /
# Anthropic) key is read anywhere (owner 2026-09-22).
DEEPSEEK_API_KEY=         # DeepSeek V4.1 Flash — api.deepseek.com (Double Checker, computer-use vision, utility)
MOONSHOT_API_KEY=         # Kimi K3 — api.moonshot.ai (Digby lead, supervisors)
ZAI_API_KEY=              # GLM-5.3 + GLM-5.3 Flash — api.z.ai (Triple Checker, coding, browser agent, image reader, PDF OCR)
DASHSCOPE_API_KEY=        # Qwen — dashscope-intl.aliyuncs.com (embeddings, rerank, helper, Digby Kids, text-to-speech, speech-to-text fallback)
TYPESAFE_API_KEY=         # Jev decision gate (TypeSafe; optional) — the "decision" seat. Unset = the gate is unservable and every decision fails open (forwarded by docker-compose.selfhost.yml since 2026-09-29)
# Image-generation timeouts (bd51693b, 2026-10-24): slow local image backends
# (Qwen-Image behind LiteLLM, 5-10 min/generation) — forwarded to backend +
# worker by docker-compose.selfhost.yml. A per-model value on the endpoint
# entry (imageTimeoutMs, clamped [30 s, 720 s] on save) always wins over the
# instance-wide env. Built-in providers are unaffected.
# IMAGE_CUSTOM_TIMEOUT_MS=300000         # per-request timeout for EVERY custom-registry image leg, clamped [120 s, 720 s]
# IMAGE_PROBE_TIMEOUT_MS=180000          # admin Test / Detect probe budget, clamped [55 s, 300 s]
# IMAGE_PROBE_TIMEOUT_DISABLED=1         # restores the pre-61d33af9 55 s probe (emergencies only)

# ── Instance ────────────────────────────────────────────────────────────────
# Isolation boundary (ticket c75b5f34): this instance is SELF-HOSTED — its
# autonomous self-improvement loop (merge → deploy → verify → auto-fix)
# targets ITS OWN repo/DB/deploy surfaces, never production Digby.
# docker-compose.selfhost.yml sets DIGBY_INSTANCE=selfhost (which arms the
# backend guards). To let this instance improve ITSELF, point the loop at
# YOUR fork of the repo (a full GitHub slug "owner/name"):
# GITHUB_REPO_SLUG=you/digby-fork    # repo the fleet pulse / telemetry / ticket fix-state read
# SELF_REPO=you/digby-fork           # repo self-merge treats as always-on (the self-improve target)
# INFRA_WATCH_REPO=you/digby-fork    # repo infra-watch watches deploy runs on
# With these unset the loop simply reports nothing about any repo; setting any
# of them to the PRODUCTION repo (the production Digby repository) hard-fails with an
# ISOLATION BOUNDARY error by design.
#
# Public URL browsers use to reach this instance. LAN: keep the default or use
# http://<your-lan-ip-or-hostname>:8080. TLS via Caddy: https://your.domain
# (then set COOKIE_SECURE=true — see deploy/selfhost/Caddyfile).
# Changing this requires a frontend rebuild (NEXT_PUBLIC_API_URL is baked in):
#   docker compose -f docker-compose.selfhost.yml up -d --build
SELFHOST_PUBLIC_URL=http://localhost:8080
SELFHOST_PORT=8080
# Bind address for the public port: 0.0.0.0 (all interfaces), 127.0.0.1
# (localhost only), or a Tailscale IP like 100.x.y.z (tailnet-only).
SELFHOST_BIND_ADDR=0.0.0.0
COOKIE_SECURE=false

# First admin (recommended): the account registered — or next signed in — with
# this email becomes ADMIN on this instance. Admins see Account → Admin → Setup,
# the checklist of what is and is not configured here, with the env names to set.
# Leave empty to promote by hand (docs/SELF_HOST.md "Quick start").
SELFHOST_ADMIN_EMAIL=

# Database password (Postgres is internal-only; still change it).
POSTGRES_PASSWORD=digby-local-password-change-me

# Coding sessions: concurrent runs the worker executes (home box: 2-8).
CODING_WORKER_CONCURRENCY=4

# Digby Edge (Phase 3): this instance can pair TO a cloud Digby over an
# outbound WS tunnel (ADMIN → POST /api/crossmodel/cloud-link/pair). Set to 1
# to keep the tunnel client off even when a cloud_link row exists.
CLOUD_LINK_DISABLED=

# ── Web search (optional — the UI and the model say "not configured" when unset) ──
# Without one of these the chat answers from the models' own knowledge, web
# pipes / feeds / headlines are off, and Account → Admin → Setup names this block.
# THREE ways to enable web search, in resolution order:
#   1. env BRIGHTDATA_API_TOKEN (below) — takes precedence when set.
#   2. The admin store — Admin → Settings → Web search in the UI: an admin
#      pastes the Bright Data API key (+ zone); it is stored server-side
#      ENCRYPTED and arms search within ~30 s (no restart). The recommended
#      path when you don't want to touch env.
#   3. The local BrightData MCP gateway (--profile mcp) below — the gateway
#      container reads BRIGHTDATA_API_TOKEN from this file, so it needs the env
#      key (a store-only instance searches through the direct API instead).
# Option A (simplest, no gateway): BrightData direct API — https://brightdata.com
BRIGHTDATA_API_TOKEN=
# Option B (with --profile mcp): the local BrightData MCP gateway — needs BOTH
# lines AND the BRIGHTDATA_API_TOKEN above (the gateway is a front for the same
# account). A self-host never falls back to Digby's mcp.digby.example.com gateway.
# MCP_DIGBY_TOKEN=          # any strong random string you invent — it gates YOUR gateway
# MCP_DIGBY_URL=http://brightdata-mcp:8000/mcp

# ── Hosted hardened browser (ticket ea3ad8a8; optional --profile browser) ──
# Per-session persistent Chromium contexts for browser_task when no Mac is
# paired. Off by default: start the stack with --profile browser AND set
# BROWSER_SERVICE_ENABLED=1 + a BROWSER_SERVICE_SECRET (the compose file passes
# the same secret to the browser-service container). Generate with: openssl rand -hex 32.
# BROWSER_SERVICE_ENABLED=1
# BROWSER_SERVICE_SECRET=
# BROWSER_SERVICE_URL=http://browser-service:3100

# ── User-added MCP servers (Account → Integrations → MCP servers) ──────────
# The SSRF fence refuses private hosts and plain http by default. On a LAN-only
# instance you may allow them (both default off):
# USER_MCP_ALLOW_PRIVATE_HOSTS=1
# USER_MCP_ALLOW_HTTP=1

# ── Coding sessions ───────────────────────────────────────────────────────────
# Dev-container memory ceiling (unset = derived from the host: host − 8 GiB,
# floor 12g). Set it on a small box, e.g. 6g.
# CODING_DEV_CONTAINER_MEMORY=

# ── Integrations (optional — require --profile mcp + OAuth app setup) ───────
# Unset providers show "Not set up on this instance" on Account → Integrations
# (admins see the env names + the callback URL to register; Account → Admin →
# Setup lists them all). For each provider you enable, create an OAuth app at
# the provider console and set its redirect URI to
#   <SELFHOST_PUBLIC_URL>/api/crossmodel/<provider>/callback
# (providers: google, github, x, slack, asana, xero). The backend derives that
# callback from SELFHOST_PUBLIC_URL by itself — set *_OAUTH_REDIRECT_URI only
# when the registered callback host differs. Details: docs/SELF_HOST.md.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_TOKEN_ENCRYPTION_KEY=    # openssl rand -hex 32 — encrypts Google, Xero AND Plaid tokens
# GOOGLE_MCP_API_KEY=             # openssl rand -hex 32 — shared backend↔MCP secret
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=
# GITHUB_TOKEN_ENCRYPTION_KEY=    # openssl rand -hex 32 — required to save ANY GitHub
                                  # account (OAuth or pasted PAT), even with no OAuth app
# GITHUB_MCP_API_KEY=
# Xero + Plaid store their tokens with GOOGLE_TOKEN_ENCRYPTION_KEY (above) — set it too.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_OAUTH_REDIRECT_URI=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox               # sandbox | development | production
# PLAID_COUNTRY_CODES=US          # comma-separated, e.g. US,CA,GB (enable them in the Plaid dashboard)
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=
# X_TOKEN_ENCRYPTION_KEY=
# X_MCP_API_KEY=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=
# SLACK_TOKEN_ENCRYPTION_KEY=
# SLACK_MCP_API_KEY=
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
# ASANA_OAUTH_REDIRECT_URI=
# ASANA_TOKEN_ENCRYPTION_KEY=
# ASANA_MCP_API_KEY=
# Discord MCP — shared bot (no per-user OAuth; the bot token lives ONLY in the
# discord-mcp container; the backend never sees it)
# DISCORD_BOT_TOKEN=
# DISCORD_MCP_API_KEY=
# DISCORD_MCP_URL=http://discord-mcp:8000/mcp

# ── Telegram bot (optional; needs a real TLS public URL for the webhook) ────
# Create the bot with @BotFather, invent a webhook secret, restart, then tell
# Telegram your webhook ONCE (Account → Admin → Setup → Telegram prints this):
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url=<SELFHOST_PUBLIC_URL>/api/crossmodel/telegram/webhook \
#     -d secret_token=<TELEGRAM_WEBHOOK_SECRET>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=        # openssl rand -hex 32

# ── Email as Digby (send_email_as_digby — ticket 54f237bf) ───────────────────
# ALL OPTIONAL — without DIGBY_SMTP_USER+PASS the tool reports "not configured"
# and sends nothing. Gmail workspace SMTP + an owner-provisioned app password
# (provisioning: docs/EMAIL_AS_DIGBY.md). Rate cap: 30 sends/hour per instance.
# DIGBY_SMTP_HOST=smtp.gmail.com
# DIGBY_SMTP_PORT=587
# DIGBY_SMTP_USER=you@example.com
# DIGBY_SMTP_PASS=
# DIGBY_SMTP_FROM=                # defaults to DIGBY_SMTP_USER

# ── Build-time switches (frontend image) ─────────────────────────────────────
# docker-compose.selfhost.yml compiles Digby's production Google Ads / GA4 tag
# and Meta Pixel OUT of your frontend build and keeps the Meta Conversions API
# off (META_CAPI_DISABLED=1). Set any of these to 0 only to report to Digby's
# own accounts — not what a self-host wants.
# NEXT_PUBLIC_GOOGLE_ADS_TAG_DISABLED=1
# NEXT_PUBLIC_GOOGLE_ANALYTICS_DISABLED=1
# NEXT_PUBLIC_META_PIXEL_DISABLED=1
# META_CAPI_DISABLED=1
