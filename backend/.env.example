# Database
DATABASE_URL=postgresql://admin:password@localhost:5432/admin_db?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
NODE_ENV=development
PORT=4000

# CrossModel AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
XAI_GROK_API_KEY=your-grok-api-key-here
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
MOONSHOT_API_KEY=your-moonshot-kimi-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# P5-A transcript merge (coding_messages → crossmodel_messages)
# Dual-write every coding message to both tables (default on; set to 'off' to disable).
# NOTE: merged is the PRIMARY write target since MERGE-1 write convergence
# (2026-11-04); 'off' now means "write coding_messages only, no merged row".
TRANSCRIPT_DUAL_WRITE=on
# Transcript WRITE direction (read per call; defaults to mirror when unset):
#   mirror  — crossmodel_messages PRIMARY, coding_messages mirrored beside it in the
#             same transaction (the blue-green overlap shape; keeps the read
#             rollback below complete). THIS IS THE DEFAULT.
#   merged  — crossmodel_messages ONLY; never touches coding_messages. Post-DROP
#             mode, and the mode that proves writes land with the legacy table gone.
#   legacy  — pre-inversion direction (coding_messages primary + merged mirror): the
#             instant WRITE rollback for a bad deploy mid-overlap.
TRANSCRIPT_WRITE=mirror
# Transcript reads: 'merged' (default, crossmodel_messages) or 'legacy'
# (coding_messages — pre-switch behavior). 'legacy' is the ONE-RELEASE read
# rollback and expires when step 5 drops the legacy table.
TRANSCRIPT_READ=merged

# ── Mobile push notifications (M1, roadmap §3.2 item 2) ──────────────────────
# ALL OPTIONAL — absent credentials leave the push module INERT (token
# registration still works; sends no-op). Expo Push needs no credentials.
# EXPO_ACCESS_TOKEN=            # optional: Expo access token (higher rate limits)
# APNS_KEY_P8=                  # Apple .p8 key contents (PEM) — direct APNs transport
# APNS_KEY_ID=                  # APNs Key ID (10 chars)
# APNS_TEAM_ID=                 # Apple Team ID
# APNS_BUNDLE_ID=               # e.g. ai.digby.mobile
# FCM_SERVICE_ACCOUNT_JSON=     # Firebase service-account JSON (single line)
# FCM_SERVICE_ACCOUNT_FILE=     # ...or a path to the service-account JSON file

# ── Email as Digby (send_email_as_digby — ticket 54f237bf) ───────────────────
# ALL OPTIONAL — without DIGBY_SMTP_USER+PASS the tool reports "not configured"
# and sends nothing (never crashes). SMTP against the Gmail workspace mailbox
# (smtp.gmail.com:587 STARTTLS + an OWNER-provisioned app password).
# Provisioning + privacy notes: docs/EMAIL_AS_DIGBY.md. Rate cap: 30/hour per instance.
# DIGBY_SMTP_HOST=smtp.gmail.com
# DIGBY_SMTP_PORT=587
# DIGBY_SMTP_USER=digby@digby.ai
# DIGBY_SMTP_PASS=              # Gmail workspace APP PASSWORD (owner step — never commit)
# DIGBY_SMTP_FROM=digby@digby.ai
