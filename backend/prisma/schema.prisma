// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CRMContactStatus {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?   // Full name
  firstName String?
  lastName  String?
  role      Role      @default(USER)
  avatar    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  // ── Digby Kids: child sub-accounts ────────────────────────────────────────
  // A child is a full User row (own login) flagged isChild with a parentId.
  // It is forced onto the locked-down kid pipeline (qwen3.6-flash + web search +
  // strict Socratic prompt) and rejected from all adult endpoints. The parent
  // sets childAge + childGuardrails (extra parental rules layered on our base
  // safety prompt) and a parentPinHash (gates child management + leaving kid mode).
  isChild         Boolean @default(false)
  childAge        Int?
  childGuardrails String? @db.Text
  parentPinHash   String?
  parentId        String?
  parent          User?   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children        User[]  @relation("ParentChildren")

  // Relations
  accounts             Account[]
  aiChats              AIChat[]
  crossModelChats      CrossModelChat[]
  crossModelProjects   CrossModelProject[]
  projectMembers       ProjectMember[]
  projectDocuments     ProjectDocument[]
  canvasDocuments      CanvasDocument[]
  content              Content[]
  kanbanBoards         KanbanBoard[]
  crmContacts          CRMContact[]
  activities           Activity[]
  refreshTokens        RefreshToken[]
  userMemory           UserMemory?
  userPreferences      UserPreferences?
  feedbacks            MessageFeedback[]
  featureRequests      UserFeatureRequest[]
  googleOAuth          GoogleOAuthToken[]
  driveWatches         DriveWatch[]
  githubOAuth          GitHubOAuthToken[]
  xOAuth               XOAuthToken[]
  xeroOAuth            XeroOAuthToken[]
  slackOAuth           SlackOAuthToken[]
  asanaOAuth           AsanaOAuthToken[]
  plaidTokens          PlaidAccessToken[]
  imessageAgents       IMessageAgent[]
  telegramLinks        TelegramLink[]
  codingCredentials    CodingCredential[]
  chatSchedules        ChatSchedule[]
  codingProjects       CodingProject[] // @deprecated (One-Digby merge) — retained for rollback; unread
  agentTokens          AgentToken[]
  pendingChatMessages  PendingChatMessage[]
  chatFiles            ChatFile[]
  // ── Fleet supervisor ──
  chatAutonomies       ChatAutonomy[]
  eventHooks           EventHook[]
  projectGoals         ProjectGoal[]
  projectTodos         ProjectTodo[]
  projectDigests       ProjectDigest[]
  digestItemAcks       DigestItemAck[]
  supervisorStates     SupervisorState[]
  generatedFiles       GeneratedFile[]
  pushTokens           PushToken[]
  contentReports       ContentReport[] // moderation queue entries (SetNull — trail survives account deletion)
  modelEndpoints       ModelEndpoint[]
  connectedInstances   ConnectedInstance[]
  cloudLinks           CloudLink[]
  // ── First-party visitor analytics (owner 2026-10-07) — Cascade: account deletion removes the trail ──
  visitorLinks         VisitorLink[]
  visitEvents          VisitEvent[]

  // ── Phase 2 Cloud: email verification + org/tenant membership (2026-11-06) ──
  // NULL = unverified. Self-host/private instances never gate on this (see
  // org/email-verification policy); the column is additive so every existing
  // account keeps working untouched.
  emailVerifiedAt DateTime?
  /// Phase 2 Cloud leg 1 item 5 (terms surfaces): WHEN this account accepted the
  /// Terms of Service + Acceptable Use, and WHICH version it accepted. NULL =
  /// never recorded — every pre-existing account, which is why enforcement is
  /// policy-gated (require_terms_acceptance, default OFF) rather than assumed:
  /// refusing registration on a NULL here would lock out the whole back catalogue.
  termsAcceptedAt DateTime?
  /// The terms version accepted (a date string matching the /terms page's
  /// "Last updated" line). Stored rather than derived so a future terms revision
  /// can tell who accepted what without guessing from account createdAt.
  termsVersion    String?
  memberships     Membership[]
  ownedOrgs       Organization[] @relation("OrgOwner")
  emailVerificationTokens EmailVerificationToken[]

  @@index([parentId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 Cloud — org/tenant model (todo ea95fa0b, leg 1 items 1-3)
//
// WHY an org and not just a userId on the quota row: the free tier must be
// enforced per TENANT, and the same model has to serve two shapes with one code
// path — a solo user (personal org, auto-created) and a team (several users
// sharing one org's quota). Putting the counters on Organization means a
// member joining a team org inherits its pool instead of dragging a second
// quota along, and Phase 3 Enterprise RBAC hangs off Membership.role.
//
// LIMIT SEMANTICS (deliberate, and load-bearing): a NULL limit means UNLIMITED.
// Every account that existed before this migration is backfilled onto a
// personal org with NULL limits, so enforcement is a no-op for them — this
// ships to prod without throttling a single existing user. Only an org with a
// numeric limit is metered.
// ─────────────────────────────────────────────────────────────────────────────

enum OrgPlan {
  FREE
  TEAM
  ENTERPRISE
}

/// What a member may DO inside one organization (Phase 3 Enterprise RBAC,
/// todo c45f065e). Interpreted in exactly ONE place — the capability table in
/// `src/modules/crossmodel/org/org-access.ts` — never by ad-hoc role literals
/// elsewhere; a structural test fails if that rule is broken.
enum OrgRole {
  /// Full control of the tenant. The only role that may grant or revoke
  /// OWNER/ADMIN, and the only one that can never be demoted by its peers.
  /// At least one OWNER must exist at all times (removal of the last is 400).
  OWNER
  /// Day-to-day operator: org settings, the member roster, and READ-ONLY
  /// billing. Deliberately cannot change billing details (not billing:update) —
  /// a member manager must not be able to redirect payments.
  ADMIN
  /// Finance seat: reads the org and manages billing details, but has no
  /// member-management capability at all (cannot invite, promote or remove).
  BILLING
  /// An ordinary member of the tenant. Can see the org itself (org:read) and
  /// NOT its roster — knowing the org exists is not the same as enumerating its
  /// people, so a plain member gets 403 on member routes.
  MEMBER
}

/// A tenant. Every user is guaranteed exactly one PERSONAL org (personal=true,
/// one membership) at creation time, so "org-optional signup" and "team org"
/// share one enforcement path. is-suspended is the per-tenant kill switch
/// (leg 1 item 4): a suspended org cannot send, without a deploy.
model Organization {
  id        String   @id @default(uuid())
  name      String
  /// URL-safe handle; personal orgs derive it from the email local-part and
  /// get a discriminator appended until unique (org.service.ts slugify).
  slug      String   @unique
  plan      OrgPlan  @default(FREE)
  /// The user who created it. SetNull so the org (and its usage history)
  /// survives its creator's account deletion — a team org must not vanish
  /// because one member left.
  ownerId   String?
  owner     User?    @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// True for the auto-created single-member org. A user's personal org is
  /// their default context; it is never shared and never deleted separately.
  personal  Boolean  @default(true)
  /// Per-tenant kill switch. True ⇒ every send from this org is refused.
  suspended Boolean  @default(false)
  suspendedReason String?
  /// NULL = unlimited (the pre-existing-account + self-host posture).
  dailyMessageLimit Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  usageDays   OrgUsageDaily[]
  modelUsageDays OrgModelUsageDaily[]

  @@index([ownerId])
  @@map("organizations")
}

/// User ↔ Organization. One row per (user, org); a user belongs to exactly one
/// PERSONAL org plus any number of team orgs (Phase 3 RBAC extends `role`).
model Membership {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole  @default(MEMBER)
  /// The org a user's sends bill against by default. Exactly one per user is
  /// enforced in code (org.service.ts ensurePersonalOrg), not by a partial
  /// unique index — personal orgs are created inside the same transaction as
  /// the user, so the invariant holds at the only creation point.
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId, isDefault])
  @@map("memberships")
}

/// Per-org, per-UTC-day message counter. One row per (org, day); the guard
/// increments it atomically BEFORE any model call and refunds on a failed
/// start, so a crashed send never silently eats a slot.
model OrgUsageDaily {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// UTC calendar day, stored as midnight UTC (the bucket key).
  day            DateTime @db.Date
  messages       Int      @default(0)
  /// Tokens summed across every model for the day (denormalized convenience;
  /// per-model detail lives in OrgModelUsageDaily).
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, day])
  @@map("org_usage_daily")
}

/// Per-org, per-UTC-day, PER-MODEL token usage (leg 1 item 3: "per-model token
/// quota"). Keyed by model id string, not a FK — model ids arrive from the
/// provider registry and legacy aliases must not require a schema change.
model OrgModelUsageDaily {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  day            DateTime @db.Date
  model          String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, day, model])
  @@index([organizationId, day])
  @@map("org_model_usage_daily")
}

/// Email-verification token for self-serve signup. The RAW token is never
/// stored — `tokenHash` is sha256(raw), so a database read cannot mint a
/// verification link. Single-use (`consumedAt`), short-lived (`expiresAt`),
/// and superseded rather than reused on resend.
model EmailVerificationToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Content reports (M2-prep — App Store 1.2/1.4, Play UGC policy): a
/// moderation-queue entry keyed to the REPORTED MESSAGE. reporterId is
/// SetNull so the moderation trail SURVIVES its reporter's account deletion
/// (anonymized — same convention as MessageFeedback.userId); chatId cascades
/// with the chat, messageId is a soft ref (the message may be deleted by the
/// run lifecycle before review; the report row persists).
model ContentReport {
  id           String    @id @default(uuid())
  reporterId   String?
  chatId       String
  messageId    String
  reason       String // REPORT_REASONS: hate_speech | harassment | sexual_content | violence | self_harm | dangerous_acts | misinformation | illegal | spam | other
  note         String?   @db.Text // optional free-text from the reporter (≤2000)
  status       String    @default("open") // 'open' | 'reviewed'
  surface      String? // 'mobile' | 'web' — where the report was filed from
  appVersion   String? // client version for triage
  reviewedAt   DateTime?
  reviewAction String? // operator's resolution note (≤200)
  createdAt    DateTime  @default(now())

  reporter User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  chat     CrossModelChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@map("content_reports")
}

/// Mobile push notification tokens (M1 — roadmap §3.2 item 2). One row per
/// (user, device token); the backend fires on run-complete so a backgrounded
/// mobile app can surface "your run finished". Tokens are Expo Push tokens by
/// default (Expo's service fans out to APNs/FCM); direct APNs/FCM credentials
/// are the fallback when Expo's throughput limits matter.
model PushToken {
  id          String    @id @default(uuid())
  userId      String
  /// The provider token: an Expo Push token (ExponentPushToken[…]) or a raw
  /// APNs/FCM device token (provider column says which).
  token       String
  /// 'expo' | 'apns' | 'fcm' — how the token must be addressed.
  provider    String    @default("expo")
  platform    String?   // 'ios' | 'android' (reported by the client)
  deviceId    String?   // client-stable id: (userId, deviceId) dedupes re-registrations
  appVersion  String?   // client-reported app version (ops telemetry)
  lastSeenAt  DateTime  @default(now()) // bumped on every registration — staleness signal
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("push_tokens")
}

/// Persistent cross-session memory for authenticated CrossModel users.
/// Stores key facts extracted from conversations (name, preferences, etc.)
model UserMemory {
  id        String   @id @default(uuid())
  userId    String   @unique
  facts     Json     @default("{}") // Key-value facts extracted from conversations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_memory")
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  type      String // local, google, github
  provider  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AIChat {
  id        String   @id @default(uuid())
  userId    String
  title     String
  messages  Json[] // Array of chat messages
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_chats")
}

model CrossModelChat {
  id        String   @id @default(uuid())
  userId    String
  projectId String?  // optional: belongs to a project
  title     String
  mode      String   @default("fast") // 'fast', 'thinking', or 'deep_research'
  // ── Fleet supervisor: ONE pinned "Fleet Supervisor" chat per OWNER (userId),
  //    auto-created lazily, full autonomy pre-granted, wildcard-hooked to every
  //    chat the owner has. Uniqueness: partial index one_supervisor_per_owner. ──
  isSupervisor Boolean @default(false) // the owner's fleet-supervisor chat (full autonomy pre-granted)
  // ── Per-project supervisor (2026-09-13): ONE ordinary chat per (owner,
  //    project) flagged here, projectId SET, created ONLY for projects whose
  //    projectSupervisorEnabled is true. NEVER reuse isSupervisor — its
  //    per-owner partial unique index + fleet semantics are load-bearing.
  //    Uniqueness: partial index one_project_supervisor_per_project (DB-only). ──
  isProjectSupervisor Boolean @default(false) // a project's dedicated supervisor chat (pause-never-delete lifecycle)
  // ── Sub-sessions (2026-09-02, audit "promote, don't build"): lineage.
  //    parentChatId = the chat/session whose run spawned this one via the
  //    start_coding_session platform tool. SOFT ref by design (no FK — same
  //    rationale as run_journal_entries.runId): a child must survive its
  //    parent's deletion and KEEP the marker, so the idle-child reaper still
  //    covers orphans and the sidebar just falls back to a flat render. The
  //    implicit parent→child autonomy check re-reads this column live per call. ──
  parentChatId String?
  // ── Display-only sidebar nesting (2026-10-21, lanefix/nesting): the fallback
  //    parent the SIDEBAR nests a machine-spawned lane under when it has no
  //    in-list parentChatId — the project's Project Supervisor (a ticket lane,
  //    a family lane, a Fleet-spawned lane in a project). Stamped once by
  //    platform.service startCodingSession for an agent-origin spawn
  //    (platform/display-parent.ts). SOFT ref, no FK, no index, never
  //    re-stamped. NEVER read by hooks, hand-off, escalation, reapers, billing
  //    or autonomy — parentChatId stays the one lineage authority (pinned by
  //    platform/display-parent.isolation.test.ts). ──
  displayParentChatId String?
  systemPrompt String?  @db.Text // per-chat custom instructions — appended AFTER the project-chain prompt (highest precedence)
  // ── Per-chat lead-seat override (WI-O #4c, 2026-09-25): a PLAIN chat's own
  //    pick for the Digby seat — a built-in id from builtInOptionsFor
  //    ('chat_orchestrator') or a '<label>:<modelId>' registry spec flagged
  //    [coding]. NULL = the instance seat (model-roles). Never honoured on
  //    supervisor chats (they resolve their own seats) or coding sessions
  //    (set_session_model owns the satellite's model). Validated on write
  //    (chat-lead-model.ts resolveChatLeadPick); servability checked per run. ──
  leadModel    String?
  // ── Ghost mode (owner 2026-10-22: "private ghost mode for a session …
  //    changes models to a specific new endpoint we set in admin or backend
  //    that points to ablitered self hosted models"): a PRIVATE chat posture.
  //    true = the run path routes EVERY leg (lead, Double Checker, council)
  //    to the ADMIN-DESIGNATED ghost endpoint (['instance','model-roles']/
  //    'ghost-endpoint', model-endpoints/ghost-endpoint.service.ts) and the
  //    chat stays out of memory extraction, learning and cross-chat digests.
  //    Refused on supervisor / coding rows (crossmodel.service.updateChat).
  //    GUESTS have no chat row — their sends carry a per-send `ghost` flag
  //    instead (streamQuery → ChatAgentRunArgs.ghost). Kill switch:
  //    CHAT_GHOST_MODE_DISABLED=1 (never honoured, honest notice). ──
  ghostMode    Boolean  @default(false)
  // ── Archive (owner 2026-09-08, "reduce clutter without permanent deletes"):
  //    NULL = live. Archived chats leave default lists/search but still load by
  //    direct id (archive is not tombstoning) and restore losslessly by clearing
  //    the stamp. Partial index crossmodel_chats_archivedAt_idx (WHERE NOT NULL)
  //    is DB-only — Prisma can't express partial indexes (same convention as
  //    one_supervisor_per_owner). ──
  archivedAt DateTime?
  // ── Session titles + topology (2026-09-27, SESSION_TITLES_TOPOLOGY design):
  //    the CHARTER a lane holds (the goal / todo its title is derived from —
  //    bound on the first todo assignment, a goal_create from the lane, or a
  //    spawn with goalId/todoId; never re-bound), the harness-derived STEP
  //    half of the title ("<goal ≤6 words> · <step ≤6 words>", rendered by
  //    platform/session-titles.ts), and the PIN a human rename sets — every
  //    repair / renderer path returns early on titlePinned. Additive, no
  //    backfill (scripts/framework-audit/session-topology-migrate.js binds
  //    charters + retitles existing lanes, dry-run first). ──
  charterGoalId String?
  charterTodoId String?
  titlePinned   Boolean  @default(false)
  titleStep     String?
  messages    Json[] // @deprecated — replaced by chatMessages relation. Kept for data backup.
  // threadState removed — now stored in PostgresStore ([chatId, 'thread'] namespace)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      CrossModelProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shareLink    ChatShareLink?
  webhook      ChatWebhook?
  canvases     CanvasDocument[]
  chatMessages CrossModelMessage[]
  pendingMessages PendingChatMessage[] // busy-chat queue — drained automatically at run end
  chatFiles   ChatFile[]           // persistent per-chat uploads (durable copies of consumed staged blobs)
  codingState  ChatCodingState?    // present iff the chat is coding-capable (P5-B: the satellite, never mode, marks coding)
  chatSchedules ChatSchedule[] // self-scheduled recurring/one-shot runs
  runJournalEntries RunJournalEntry[] // append-only cross-run memory (what earlier runs did/decided)
  runToolReceipts  RunToolReceipt[]  // harness-written execution receipts (anti-confabulation evidence)
  contentReports  ContentReport[]   // moderation queue entries (M2-prep store compliance)
  // ── Fleet supervisor ──
  autonomy     ChatAutonomy?       // per-chat autonomous-tool allowlist (owner-granted)
  hooksSource  EventHook[]    @relation("HookSource")
  hooksTarget  EventHook[]    @relation("HookTarget")
  supervisorState SupervisorState? // durable state doc — present iff this is the supervisor chat (2026-08-22 rebuild)

  @@index([userId])
  @@index([mode])
  @@index([projectId])
  @@index([parentChatId])
  @@map("crossmodel_chats")
}

/// Individual chat messages — replaces the JSONB messages[] array for O(1) appends.
/// Each row = one user or assistant message. Assistant messages carry metadata (model responses, timing).
model CrossModelMessage {
  id        String   @id @default(uuid())
  chatId    String
  role      String   // 'user' | 'assistant'
  content   String   @db.Text
  metadata  Json?    // Model responses, timing, etc. (assistant messages only)
  parts     Json?    // One-Digby agent engine: ordered agent parts (CodingMessage shape); null = legacy pipeline
  createdAt DateTime @default(now())
  // Ticket 68916075: last-write stamp (≈ finalize time for coding-run assistant rows that are
  // INSERTed at run start and rewritten in place). Nullable on purpose — historical rows read
  // NULL (honest "predates this field") instead of a mass-stamped migration instant.
  // createdAt is NEVER restamped — it is the ordering/cursor contract.
  updatedAt DateTime? @updatedAt

  chat      CrossModelChat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  feedbacks MessageFeedback[]

  @@index([chatId])
  @@index([chatId, createdAt])
  @@map("crossmodel_messages")
}

/// Busy-chat message queue (2026-08-07): a message sent to a chat while a run
/// is ACTIVE persists here instead of being dropped (previously the tool path
/// 409'd and the SSE path errored — the content was lost). The finishing run's
/// finally drains the OLDEST row as a normal detached turn
/// (chat-agent.service drainChatQueue); one per drain, so a full queue unrolls
/// as a FIFO chain of runs. Capped per chat (MAX_QUEUE_DEPTH in
/// chat-agent/message-queue.service.ts) — over the cap senders get a 409.
model PendingChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  content   String   @db.Text
  mode      String?  // resolved chat-agent level captured at enqueue time
  source    String   // 'user' (SSE stream) | 'agent' (send_chat_message tool) | 'webhook' (inbound webhook fire)
  /// Staged /crossmodel/upload ids (ticket ac65d51e) — queued messages carry
  /// their attachments; the drain resolves them like an immediate send. Redis
  /// TTL on each cm:upload:<id> is extended at enqueue so blobs outlive the dwell.
  uploadIds Json?
  createdAt DateTime @default(now())

  chat      CrossModelChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("pending_chat_messages")
}

/// Persistent per-chat files — durable copies of user UPLOADS (2026-08-25).
/// A staged /crossmodel/upload blob (Redis cm:upload:<id>, 15-min TTL) is
/// persisted here the moment it is actually CONSUMED by a send (SSE stream,
/// busy-queue drain, fleet supervisor send, coding-surface inline) so the file
/// outlives the staging TTL and stays downloadable/inline-previewable for
/// anyone with read access to the chat. Idempotent per (uploadId, chatId):
/// the unique key makes a retried/queued re-resolution a no-op. `data` holds
/// the best available bytes — the original binary for images/PDFs (base64 in
/// the staged blob), the extracted text (UTF-8) for documents (the staging
/// format keeps no binary for those — mimeType is then normalized to
/// text/plain so served bytes always match Content-Type). GC is by
/// onDelete: Cascade from the parent chat. Generated files (agent-created
/// documents) are a SEPARATE system — see GeneratedFile.
model ChatFile {
  id        String   @id @default(uuid())
  chatId    String
  userId    String   // the uploader
  uploadId  String?  // Redis staging id it came from — dedupe key with chatId
  filename  String
  mimeType  String
  sizeBytes Int      // byte length of `data`
  data      Bytes    // Postgres bytea
  createdAt DateTime @default(now())

  chat CrossModelChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([uploadId, chatId])
  @@index([chatId, createdAt])
  @@map("chat_files")
}

/// User feedback on individual AI responses — powers autopilot analysis + product improvement.
/// Tracks thumbs down, reports, and optional free-text reasons.
model MessageFeedback {
  id        String   @id @default(uuid())
  messageId String?  // CrossModelMessage.id — nullable for legacy/anonymous
  chatId    String   // CrossModelChat.id for correlation
  userId    String?  // null = anonymous user
  type      String   // 'thumbs_down' | 'thumbs_up' | 'report'
  reason    String?  // 'wrong' | 'harmful' | 'slow' | 'formatting' | 'incomplete' | 'other'
  comment   String?  @db.Text // Free-text user comment
  modelSet  String?  // 'frontier' | 'open_source'
  resolved  Boolean  @default(false) // Autopilot marks true after addressing
  createdAt DateTime @default(now())

  user    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  message CrossModelMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([chatId])
  @@index([userId])
  @@index([type])
  @@index([resolved, createdAt])
  @@map("message_feedback")
}

/// Projects (folders) that organize chats + documents — like Claude Projects / ChatGPT Projects
model CrossModelProject {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?  @db.Text
  systemPrompt String?  @db.Text // custom instructions prepended to all chats in this project
  emoji        String?            // e.g. "🚀" "📁" "💡"
  color        String?            // violet, blue, green, amber, rose
  isPublic     Boolean  @default(false)
  supervised   Boolean  @default(true) // opt-in fleet supervision: false removes this project from AUTOMATIC supervision (wildcard hooks, hourly digests, watchdog alerts) — direct event hooks + user-action items are never filtered
  // ── Per-project supervisor (owner directives 2026-09-13 23:15Z/23:34Z): OPT-IN.
  //    true scaffolds ONE dedicated "Project Supervisor" chat for this project
  //    (isProjectSupervisor on crossmodel_chats) + its project-scope event hook +
  //    hourly sweep schedule; toggling false PAUSES them (hooks/schedules disabled,
  //    chat/transcript/state NEVER deleted). Distinct from `supervised`, which is
  //    the fleet-wildcard opt-out and stays untouched by this flag. ──
  projectSupervisorEnabled Boolean @default(false)
  // ── Auto-archive idle chats (ticket bb86cee8, owner ask 2026-09-14): OPT-IN.
  //    NULL = feature off. An integer 1..365 = the hourly idle-chat-archiver
  //    cron archives this folder's chats whose updatedAt is older than that
  //    many days — through the same reversible archiveChat path the UI uses
  //    (archivedAt stamp + coding-satellite flip + audit), never a raw update. ──
  autoArchiveIdleDays Int?
  isUserSpace  Boolean  @default(false) // User Space (P3): the owner's ONE hidden personal "Workspace" project chats auto-file into (partial unique index crossmodel_projects_one_userspace_per_owner is DB-only)
  shareToken   String?  @unique   // for public project share links
  // contextState removed — now stored in PostgresStore ([projectId, 'context'] namespace)
  // ── Workspace (One-Digby merge, 2026-07: every project can carry a git workspace) ──
  repoUrl       String?   // https clone URL (github/git) — null for local/blank/plain
  repoProvider  String?   // 'github' | 'git' | 'local' | 'blank'(legacy session-chained); null = plain project
  defaultBranch String    @default("main")
  githubLabel   String?   // which connected GitHub account's token to use
  workspaceAt   DateTime? // when the workspace was first provisioned on disk; null = never
  // ── Folder tree (P0 platform unification): projects are folders; folders nest ──
  parentId String?
  depth    Int    @default(0)
  path     String @default("") // materialized "/rootId/.../id" for O(1) subtree/breadcrumb queries
  // ── Archive (owner 2026-09-08): NULL = live. Archiving a folder stamps ONLY
  //    this row — its chats and descendant folders ride along implicitly
  //    (default lists hide the whole subtree via the materialized path), so
  //    restore is instant and lossless. Partial index
  //    crossmodel_projects_archivedAt_idx (WHERE NOT NULL) is DB-only. ──
  archivedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       CrossModelProject?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     CrossModelProject[] @relation("ProjectHierarchy")
  chats        CrossModelChat[]
  documents    ProjectDocument[]
  members      ProjectMember[]
  codingStates ChatCodingState[]
  goals        ProjectGoal[] // fleet-supervisor: structured goals + todos
  digests      ProjectDigest[] // hourly per-project digest rows (null-project bucket lives on User only)

  @@index([userId])
  @@index([parentId])
  @@index([path])
  @@map("crossmodel_projects")
}

/// Who a project is shared with (viewer / editor / admin)
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("viewer") // viewer | editor | admin
  addedAt   DateTime @default(now())

  project CrossModelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Scoped API tokens a user mints for external agents/scripts (P0 platform unification).
/// The raw token is shown once at mint; only its sha256 hash is stored.
/// Scopes: chats:read, chats:write, folders:write, schedules:write, code:run.
model AgentToken {
  id          String    @id @default(uuid())
  userId      String
  name        String
  tokenHash   String    @unique // sha256 hex of the presented bearer token
  tokenPrefix String // first ~12 chars, for UI identification ("dgt_ab12cd34…")
  scopes      String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agent_tokens")
}

/// Documents uploaded or URL-analyzed for a project's knowledge base
model ProjectDocument {
  id         String   @id @default(uuid())
  projectId  String?  // null = ungrouped (appears in global Files folder)
  userId     String
  name       String   // display name
  mimeType   String   // pdf | docx | txt | url | pasted
  sourceUrl  String?  // populated if mimeType = url
  source     String   @default("knowledge") // "knowledge" | "chat_upload" | "gmail_attachment" (99145890: sourceUrl then carries the gmail://<messageId>/<filename> dedup key)
  charCount  Int      @default(0)
  chunkCount Int      @default(0)
  status     String   @default("processing") // processing | ready | error
  errorMsg   String?
  createdAt  DateTime @default(now())

  project CrossModelProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks  ProjectChunk[]

  @@index([userId])
  @@index([projectId])
  @@map("project_documents")
}

/// Chunked + embedded text for RAG retrieval (pgvector)
model ProjectChunk {
  id         String                      @id @default(uuid())
  documentId String
  projectId  String?
  userId     String
  content    String                      @db.Text // contextualized chunk (Kimi-prepended context sentence)
  embedding  Unsupported("vector(1536)") // OpenAI text-embedding-3-small, 1536 dims
  chunkIndex Int // position in document (0-based)
  tokenCount Int      @default(0)
  metadata   Json? // { page?, section?, sourceUrl?, fileName }

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([documentId])
  @@map("project_chunks")
}

/// Binary files created by the agent document tools (create_document etc.).
/// Payload stored base64; textContent keeps a plain-text rendering for
/// read_document and previews.
model GeneratedFile {
  id          String   @id @default(uuid())
  userId      String
  chatId      String?  // bare column (NO FK) — chat the file was created in, if known
  filename    String
  format      String   // txt | md | csv | json | xlsx | docx | pdf
  mimeType    String
  size        Int      // decoded bytes
  data        String   @db.Text // base64 payload
  textContent String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("generated_files")
}

/// Canvas documents created by AI during chat (like Claude Artifacts / ChatGPT Canvas)
model CanvasDocument {
  id        String   @id @default(uuid())
  chatId    String
  userId    String
  title     String
  type      String   @default("document") // document | code | html | mermaid | table
