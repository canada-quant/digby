  chat      CrossModelChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLink CanvasShareLink?

  @@index([chatId])
  @@index([userId])
  @@map("canvas_documents")
}

/// Public share links for individual chats (read-only, no auth required)
/// Public share link for ONE canvas artifact (html/code/document) — the token
/// URL serves the rendered artifact to ANYONE (no auth). Served straight from
/// this row through the backend: one service for every chat's artifacts, no
/// per-project containers (future-proofing decision, 2026-07-19).
model CanvasShareLink {
  id         String    @id @default(uuid())
  canvasId   String    @unique
  shareToken String    @unique
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  canvas CanvasDocument @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@map("canvas_share_links")
}

model ChatShareLink {
  id         String    @id @default(uuid())
  chatId     String    @unique
  shareToken String    @unique
  isActive   Boolean   @default(true)
  expiresAt  DateTime? // null = never expires
  createdAt  DateTime  @default(now())

  chat CrossModelChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_share_links")
}

/// Per-chat inbound webhook (2026-08-23, feedback 111ab0e4): an external system
/// (health monitor, CI failure, deploy hook) wakes this chat by POSTing
/// {message} to /api/crossmodel/webhooks/:chatId/fire with
/// Authorization: Bearer dgw_…. The run then fires exactly like a user send
/// (platform.service sendChatMessage: idle → run starts, busy plain → queued,
/// busy coding → steer), stamped metadata.origin 'webhook' (machine traffic).
/// Only the SHA-256 hash of the token is stored — the plaintext is shown ONCE
/// at creation/rotation; tokenPrefix identifies the token to the owner.
/// One webhook per chat; rotation replaces the hash, revocation deletes the row.
model ChatWebhook {
  id          String    @id @default(uuid())
  chatId      String    @unique
  tokenHash   String    // sha256 hex of the bearer token
  tokenPrefix String    // first 12 chars ("dgw_ab12cd34") — owner-facing identifier
  label       String?   // optional owner note ("gateway monitor", "CI deploys")
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime? // last successful token verification
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chat CrossModelChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_webhooks")
}

model Content {
  id          String        @id @default(uuid())
  userId      String
  title       String
  slug        String        @unique
  body        String        @db.Text // Rich text content
  excerpt     String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("contents")
}

model KanbanBoard {
