{
  "name": "digby-backend",
  "version": "1.0.0",
  "description": "Digby backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "decision-gate:fit": "sh -c 'if [ -f dist/scripts/decision-gate-fit-temperature.js ]; then echo \"decision-gate:fit → dist/scripts (compiled; run npm run build to refresh)\" >&2; exec node dist/scripts/decision-gate-fit-temperature.js \"$@\"; else exec npx tsx src/scripts/decision-gate-fit-temperature.ts \"$@\"; fi' decision-gate-fit",
    "decision-gate:export": "sh -c 'if [ -f dist/scripts/decision-gate-export.js ]; then echo \"decision-gate:export → dist/scripts (compiled; run npm run build to refresh)\" >&2; exec node dist/scripts/decision-gate-export.js \"$@\"; else exec npx tsx src/scripts/decision-gate-export.ts \"$@\"; fi' decision-gate-export",
    "decision-gate:cascade": "sh -c 'if [ -f dist/scripts/decision-gate-cascade.js ]; then echo \"decision-gate:cascade → dist/scripts (compiled; run npm run build to refresh)\" >&2; exec node dist/scripts/decision-gate-cascade.js \"$@\"; else exec npx tsx src/scripts/decision-gate-cascade.ts \"$@\"; fi' decision-gate-cascade",
    "dream:learnings": "tsx src/scripts/dream-learnings.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "eval:trajectory": "jest src/modules/crossmodel/evals/trajectory --runInBand",
    "eval:trajectory:live": "EVAL_TRAJECTORY_LIVE=1 jest src/modules/crossmodel/evals/trajectory/trajectory-live.test.ts --runInBand",
    "eval:trajectory:new": "tsx src/modules/crossmodel/evals/trajectory/new-case.ts",
    "eval:trajectory:calibrate": "tsx src/modules/crossmodel/evals/trajectory/calibrate.ts",
    "switches:check": "tsx scripts/switches.ts check",
    "switches:sync": "tsx scripts/switches.ts sync",
    "switches:report": "tsx scripts/switches.ts report",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "postinstall": "test -f prisma/schema.prisma && npx prisma generate || true"
  },
  "keywords": [
    "admin",
    "dashboard",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@langchain/core": "^1.1.29",
    "@langchain/textsplitters": "^1.0.1",
    "@node-saml/node-saml": "^5.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/multer": "^2.3.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "ws": "^8.21.3",
    "youtubei.js": "^18.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/heic-convert": "^2.1.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "prisma": "^7.9.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
