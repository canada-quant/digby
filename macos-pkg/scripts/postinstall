#!/bin/bash
#
# Runs as root after the payload is laid down at /Library/Digby/imessage-agent.
# Installs a per-user LaunchAgent (so it runs in the user's GUI session — able to
# read Messages and show the native pairing/permission popups) and starts it.
#
set -u

INSTALL_DIR="/Library/Digby/imessage-agent"
LABEL="ai.digby.imessage-agent"

# Who is actually logged into the GUI? (postinstall runs as root)
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || echo "")"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  # No GUI user (e.g. installed at login window) — it'll start at next login.
  exit 0
fi
USER_UID="$(id -u "$CONSOLE_USER")"
USER_HOME="$(eval echo "~$CONSOLE_USER")"

# ── Yield to a self-managed install (ticket 405927c9) ─────────────────────────
# The one-line installer's agent (label com.digby.agent, at ~/Library/
# Application Support/Digby/imessage-agent) SELF-UPDATES and outranks this
# .pkg: it is the only install shape with an update path, and its agent
# (≥0.9.2) retires stale installs by plist content anyway. Installing this
# .pkg over one must not create a SECOND polling agent with the same token
# (the agentVersion flap behind "still says I have old 0.63"). When a
# self-managed launchd job exists, we lay down the payload but never install
# a competing one — nothing at /Library/Digby will run.
SELF_PLIST="$USER_HOME/Library/LaunchAgents/com.digby.agent.plist"
if [[ -f "$SELF_PLIST" ]]; then
  echo "  A self-managed Digby agent is already installed and keeps itself"
  echo "  up to date — this installer leaves it running. The files it laid"
  echo "  down at $INSTALL_DIR stay for a clean future install; nothing"
  echo "  there will run or poll."
  exit 0
fi
LA_DIR="$USER_HOME/Library/LaunchAgents"
PLIST="$LA_DIR/$LABEL.plist"
LOG_DIR="$USER_HOME/Library/Logs/digby-agent"

mkdir -p "$LA_DIR" "$LOG_DIR"

# ── digby-agent CLI shim (ticket 69ce3f01) ────────────────────────────────────
# docs/UNATTENDED_DEVICES.md documents the CLI as `digby-agent <subcommand>`,
# but package.json's "bin" entry only lands on PATH via a global install or
# `npm link` — no Digby install shape does either, so the owner got
# `sudo: digby-agent: command not found` from a documented line.
#
# This runs AFTER the self-managed yield above: if a one-line install owns this
# Mac, its own shim is already correct for the tree that actually runs, and the
# /Library/Digby payload is inert — writing a shim that points at it would
# resurrect the stale-version class of 405927c9. The canonical shim path is
# shared on purpose: whichever install shape ran last leaves it pointing at the
# live tree, so the two can never disagree about what `digby-agent` means.
#
# ABSOLUTE paths, never $HOME: the runbook runs `remote-access` under sudo,
# where $HOME is root's home and no agent exists.
CLI_DIR="$USER_HOME/Library/Application Support/Digby/bin"
CLI_SHIM="$CLI_DIR/digby-agent"
mkdir -p "$CLI_DIR"
cat > "$CLI_SHIM" <<CLI
#!/bin/sh
# digby-agent — generated by the Digby iMessage Agent installer (.pkg).
# Absolute paths on purpose: under sudo \$HOME is root's home, and sudo does
# not inherit your shell's PATH. Re-run the Digby installer to regenerate.
exec "$INSTALL_DIR/DigbyAgent" "$INSTALL_DIR/dist/index.js" "\$@"
CLI
chmod 755 "$CLI_SHIM"
# Only what THIS script created — never -R over the shared Digby support root,
# which may hold a live self-managed agent tree this .pkg must not touch.
chown "$CONSOLE_USER":staff "$USER_HOME/Library/Application Support/Digby" \
                            "$CLI_DIR" "$CLI_SHIM" 2>/dev/null || true
echo "  The 'digby-agent' command is at: $CLI_SHIM"
echo "  Add it to PATH once to run it as plain 'digby-agent':"
echo "    echo 'export PATH=\"\$HOME/Library/Application Support/Digby/bin:\$PATH\"' >> ~/.zshrc"

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 51d8dbe0: the Digby-named runtime — TCC lists the executable's name,
         so the Full Disk Access entry reads "DigbyAgent", not "node". -->
    <string>$INSTALL_DIR/DigbyAgent</string>
    <string>$INSTALL_DIR/dist/index.js</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$LOG_DIR/digby-agent.log</string>
  <key>StandardErrorPath</key>
  <string>$LOG_DIR/digby-agent.err.log</string>
</dict>
</plist>
PLIST

chown "$CONSOLE_USER":staff "$PLIST"
chown -R "$CONSOLE_USER":staff "$LOG_DIR"

# (Re)load into the logged-in user's GUI domain.
launchctl bootout "gui/$USER_UID" "$PLIST" 2>/dev/null || true
launchctl bootstrap "gui/$USER_UID" "$PLIST" 2>/dev/null \
  || sudo -u "$CONSOLE_USER" launchctl load "$PLIST" 2>/dev/null \
  || true

exit 0
