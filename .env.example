# ── TIME-SLICED MACHINE RUNS (2026-10-16, coding/machine-run-budget.ts — todo 89df978b, OBSERVE-ONLY) ──
# Which machine runs a run budget WOULD have cut at a step boundary. Every unattended
# machine run records machine_run_duration (wall-clock min, the p95 source); one outliving
# the budget also records machine_run_would_cut (budgetMin/overMin/steps/stepBudget/attempts/
# checkpointed/waitingBehind/queueWaitMs) — the measured false-positive-rate input for a
# FUTURE act-path decision (gate-flip doctrine). NEVER cuts, cancels, requeues or mutates a
# schedule: the runDeadlineMs step-boundary collapse + checkpoint + interrupted-requeue
# machinery already exist and stay untouched; only the observation is new.
# MACHINE_RUN_BUDGET_OBSERVER_DISABLED=1 # kill switch: both metrics stop recording (runs unaffected either way)
# MACHINE_RUN_BUDGET_MS=3600000        # observation budget, default 60 min (floor 60_000 — a mis-set env must
#                                  #   never mark healthy runs would-cut). The act-path budget is NOT this env.
# ── ANSWER-KEY GUARD (2026-10-03, coding/answer-key-guard.ts — OPT-IN, for benchmark evaluations only) ──
# Production stays OFF (prod lanes legitimately work on benchmark repos). docker-compose.app.yml does NOT
# forward these keys: enable it on the bench backend's own override file (backend AND worker services).
# ANSWER_KEY_GUARD=1              # on: web tools / github_* reads / web_pipe refuse deny-listed benchmark answer-key
#                                  #   URLs + queries before any network call, withhold canary-carrying results and drop
#                                  #   deny-listed search entries; run_command refuses a command whose text names a
#                                  #   deny-listed URL / host path and withholds a REMOTE fetch's output carrying a canary
#                                  #   (local reads never touched). Each block = ONE loop_metrics answer_key_blocked row.
# ANSWER_KEY_GUARD_DISABLED=1     # force-off kill switch (wins over ANSWER_KEY_GUARD=1).
# ANSWER_KEY_DENY_PATTERNS=       # extra deny regexes (case-insensitive), newline- or comma-separated (a comma inside
#                                  #   {m,n} is kept; invalid regexes are skipped), e.g. mirror\.example\.org/bench
# ANSWER_KEY_CANARIES=            # extra canary literals (case-insensitive substrings), comma- or newline-separated.
#                                  #   quota / balance backs off + retries the same request (never the shrink lane) and fails the lead
#                                  #   seat over like a 429. 1 restores the old handling (403 = size lane, no failover).
