SUPERVISOR_OWNER_TURN_RECEIPTS_DISABLED=
# SUPERVISOR_UNBACKED_CLOCK_NARROW_DISABLED=1 # 2026-10-18 (318b3175): a claim sentence's own parenthetical status clock ("(3:13 PM PDT / 22:13Z)") no longer exempts a live zero-tool send claim from the rewrite; 1 restores any-clock exemption
# SUPERVISOR_UNBACKED_DISCLAIMER_NARROW_DISABLED=1 # a disclaimer cue anywhere 40 chars before the claim suppresses the check again
# RECEIPT_TOOL_TRIPLE_GROUNDING_DISABLED=1   # 2026-10-16 (unbacked-claim.ts, todo d597ce5d): 1 turns off the
#                                  #   (verb, tool, id) triple check — a cited receipt id that resolves to a
#                                  #   receipt of the WRONG tool class for the claim's verb ("Resolved ticket
#                                  #   9c307167 … receipt ticket 9c307167" backed only by file_feedback) stops
#                                  #   recording the observe-only receipt_tool_mismatch metric.
# SEARCH_CHATS_INCLUDE_ARCHIVED_DISABLED=1    # search_chats excludes archived chats by default again
# ACTION_VERIFIER_CLAIM_SHAPE_GATE_DISABLED=1 # LLM-extracted verifier claims are not id-shape / verb-kind checked (a git sha could read as a ticket id)
# OWNER_NOTE_NO_EDIT_DISABLED=1               # a verifier strike strips + marks owner-facing notes again
# ACTION_CLASS_ANNOTATE_DISABLED=1            # 2026-10-20 BRIEFING-UNVERIFIED-FILTER: no observe-only footnote naming a supervisor wake's
#                                             #   id-less action-class convictions / zero-tool dispatch claims (the note is delivered unmodified again)
# BRIEFING_UNVERIFIED_FILTER_DISABLED=1       # 2026-10-20: the owner briefing no longer marks those claims "(unverified)" / leaves them out of the LLM rewrite
# STRUCK_NOTE_REPEAT_DISABLED=1               # 2026-10-21 release switch (chat-agent/struck-note-repeat.ts, tickets 4c7aebf7 + 9a976d83):
#                                             #   a machine-run final that is >= 90% the same (timestamps normalised) as the chat's previous
#                                             #   STRUCK note is delivered as fresh work again. Default ON = it rides the bounded reject-back
#                                             #   ONCE with a notice naming the repeat + the struck claims; a retry that still repeats is
#                                             #   delivered as written with one observe-only annotation (no owner briefing); loop_metrics
#                                             #   struck_note_repeat {outcome fresh|clean|still_repeat_annotated|retry_failed|annotated_no_retry}.
#                                             #   Round 2 (same switch): supervisor-class chats only; a repeat also needs the same numbers / ids;
#                                             #   a supervisor no-op note is never compared; the repeat annotation is not itself a strike;
#                                             #   harness rows never hide the struck note; a planned repeat defers the clock-lane ticket.
#                                             #   Round 3 (same switch): the no-op skip needs an explicit no-op marker closing the note; a note
#                                             #   struck only by the computer_task claim check is never a repeat.
#                                             #   Round 4 (same switch): a struck note costs AT MOST ONE reject-back, ever — no carry-through, and a
#                                             #   delivered copy is stamped spent (metadata.struckNoteRepeat) so no later copy is bounced; the
#                                             #   reject-back is skipped (annotated instead) when the run fired a replay-unsafe tool (a send, a
#                                             #   desktop action) — the only skip (round 5: tool results that echo / quote the struck note never
#                                             #   skip it); a failed retry is re-guarded on the pass-1 clock. Outcomes add ineligible /
#                                             #   annotated_replay_unsafe / guard_cycle_repeat (skipped, but the guard's own reject-back re-ran
#                                             #   the wake anyway — worded as such)
# PRIOR_NOTE_STRUCK_BLOCK_DISABLED=1          # 2026-10-21 release switch: the next machine turn after a struck note no longer carries the
#                                             #   short [PRIOR NOTE STRUCK] system block (acknowledge + re-run the flagged claims with fresh
#                                             #   tool calls). With BOTH switches set the prior note is not read at all (today byte-for-byte)
# COMPUTER_TASK_CLAIM_CHECK_DISABLED=1        # 2026-10-21 release switch (chat-agent/computer-task-claims.ts, related to ticket 4c7aebf7 part
#                                             #   (c) — part (c) itself, the inline harness counters, is not built): the computer_task claim check
#                                             #   is off entirely — no check, no row. Default ON = OBSERVE-ONLY (round 4): a supervisor machine
#                                             #   note that says it clicked / typed / pressed / drove the screen while the run made no
#                                             #   computer_task call, or every call was observe-only / busy / unavailable, gets ONE counts-only
#                                             #   loop_metrics row (kind computer_task_claim — reason class + counts, never note text) and is
#                                             #   NOT touched: no annotation, no strike, no [PRIOR NOTE STRUCK] block, no briefing change.
#                                             #   Claims are narrow: a device word counts only as the object / place of a screen-input verb
#                                             #   (never "the computer_task fix", "a Mac agent ticket"); platform verbs (opened / applied /
#                                             #   saved / edited …), plans, other agents' actions, hedges, acknowledgement / retraction lines
#                                             #   and past-turn recaps never count. Round 5 (same switch): only the first 20 000 chars of a
#                                             #   note are mined and a sentence over 1 500 chars is skipped; questions, a "No —" reply and a
#                                             #   verb placed on a PR / lane / deploy / ticket never count; a platform verb's device place no
#                                             #   longer makes a coordinated verb a claim
# COMPUTER_TASK_CLAIM_ANNOTATE_ENABLED=1      # 2026-10-21 OPT-IN (default OFF): the claim check above also annotates an unbacked note —
#                                             #   delivered as written + ONE observe-only annotation naming the claims, one guard_strike row
#                                             #   (seam machine_wake_computer_task_claim, skipped by the nightly adjudicator), a strike for the
#                                             #   next turn's [PRIOR NOTE STRUCK] block (never a repeat reject-back); the owner briefing still
#                                             #   runs and marks the claim lines "(unverified)". Arm it only after reading a week of
#                                             #   computer_task_claim rows. Ignored while COMPUTER_TASK_CLAIM_CHECK_DISABLED=1 (a stored
#                                             #   annotation is then no [PRIOR NOTE STRUCK] strike either)
