#                                  # evidence of absence" with the caller's own probes, and a supervisor chat searches the platform repo's index
# GITHUB_FILE_READ_TOOL_DISABLED=1  # fs-code-knowledge (2026-10-22): removes the read-only github_get_file_contents tool (and the pointer to
#                                  # it in github_search_code) — the direct "is this file on main?" read for runs without a worktree
# GITHUB_NOT_FOUND_FALLTHROUGH_DISABLED=1  # fs-code-knowledge review (2026-10-22): getFileContents returns the FIRST connected GitHub account's
#                                  # "Not Found" again; ON (default) a 404 is a per-account miss (GitHub 404s a private repo the token cannot
#                                  # see) — every connected account is tried and the 404 is the answer only once all missed
# GITHUB_LISTING_SOURCES_DISABLED=1  # ticket 659b5074: restores the old URL harvest of github_search_code LISTING results into the Sources
