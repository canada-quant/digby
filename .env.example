# RESULTS_LOG_GUARD_DISABLED=1     # self-merge G6 + the open_pull_request [RESULTS-LOG NOTICE] off (no contents read)
# RESULTS_LOG_GUARD_ENFORCE=1      # OPT-IN: G6 refuses the merge (gate results_log) when a results/tracker log loses
#                                  # ≥ RESULTS_LOG_MAX_DELETED_LINES lines AND ≥ 50 % of its pre-PR bytes with no archive/
#                                  # file added in the same diff. Unset = evidence note + guard_strike {seam:results_log_truncate}.
# RESULTS_LOG_GLOB=results/**/*.md,**/*results*.md,**/*tracker*.md,**/*log*.md   # the files G6 watches (comma-separated)
# RESULTS_LOG_MAX_DELETED_LINES=200 # the deletion floor before a contents-size read happens
# MERGE_RECEIPTS_DISABLED=1        # merge_pull_request mints no run_tool_receipt again (pre-2026-09-27: 287 merges, 0 receipts)
# SELF_REPO=example-org/crossmodel  # the deployment's own repo — ALWAYS self-merge
#                                  # (owner directive 2026-09-09); default shown
# DIGBY_INSTANCE=prod              # instance kind (ticket c75b5f34 isolation boundary):
#                                  # unset/'prod' = the production instance (keeps every
#                                  # historical default above); 'selfhost'/'edge'/any other
#                                  # = a NON-prod instance whose self-improve loop targets
#                                  # ITS OWN env (SELF_REPO/GITHUB_REPO_SLUG/INFRA_WATCH_REPO)
#                                  # — those never fall back to a prod target, and resolving
#                                  # one hard-fails with an ISOLATION BOUNDARY error.
#                                  # docker-compose.selfhost.yml sets DIGBY_INSTANCE=selfhost.
# Branch hygiene (owner 2026-09-14: "the framework isnt automatically deleting
# branches after they are merged … looking like session history") — durable-cron
# + self-merge kill-switches, all default OFF (features active). Set =1 to disable:
# SESSION_HISTORY_SYNC_DISABLED=1          # stop the 10-min session HISTORY.md → origin sync entirely
# SESSION_HISTORY_SYNC_AUTH_DISABLE_DISABLED=1 # stop DISABLING a repo's history sync after 3
#                                          # consecutive terminal-auth push refusals (ticket 5eb035d6:
#                                          # skip silently, one info log, one re-probe push per 24h —
#                                          # unset = that stop is ACTIVE. The archived/gone-project
#                                          # skip is unconditional; only the auth-disable leg has a
#                                          # kill switch).
# DELETED 2026-11-04 (RSW-1 delete-with-ledger cluster 42, goal 393f731e): was
# SESSION_HISTORY_SINGLE_BRANCH_DISABLED=1 — restored the legacy per-session
# digby/session-history/<id> branches. It was NF_INERT (no build ever forwarded
# it), so the consolidated mode is now unconditional: ONE branch per repo
# (digby/session-history, sessions/<id>/HISTORY.md), dead sessions pruned from
# the tree, legacy branches deleted on origin during the first pass. Do not
# re-add.
# BRANCH_JANITOR_DISABLED=1                # skip the hourly branch janitor (deletes fully-merged /
#                                          # squash-merged / closed-PR lane branches + legacy session-
#                                          # history mirrors on every managed GitHub repo; never main,
#                                          # protected, open-PR heads, <2h-old tips, or non-framework
#                                          # prefixes unless fully merged; ≤50 deletions per pass)
# BRANCH_JANITOR_DRY_RUN=1                 # janitor only LOGS what it would delete (metric branch_janitor
#                                          # still lands with dryRun:true) — review a day before trusting it
# BRANCH_JANITOR_EXTENDED_RULES_DISABLED=1 # 2026-10-21 release switch: restore the pre-2026-10-21 janitor rules.
#                                          # Unset, on the framework's OWN repo only (SELF_REPO; the platform
#                                          # repo on prod): fo/ + state/ follow the digby/ rules (tip >= 48 h);
#                                          # a docs-only repush (.digby/ memory-bank/ docs/ *.md) >= 48 h after
#                                          # the PR closed is deleted; audit/ ops/ batch/ probe- branches >= 48 h
#                                          # are deleted when merged or every code file is already on default
#                                          # (same blob); the pass's deleted tips go into ONE archive commit +
#                                          # ONE tag refs/tags/archive/<yyyy-mm-dd>/branch-janitor-<HHMM>Z
#                                          # (no archive = the new deletes wait; pr_merged/pr_closed go ahead).
#                                          # Every repo: digby/session-history and live digby/session-<id8>
#                                          # lanes are kept. Restore a branch: git push origin <sha>:refs/heads/<name>
#                                          # (the archive commit's message lists every "<branch> <sha>").
#                                          # Third review (2026-10-22): an archived delete re-reads its ref first
#                                          # (compare-and-swap) — a branch pushed to during the pass is kept_moved.
#                                          # ON for 1 / true / on (the lane-lifecycle wave's one parser).
# BRANCH_JANITOR_REVIEWED_DELETES_DISABLED=1 # 2026-10-22 release switch: never read the reviewed-deletes manifest.
#                                          # Unset, on the framework's OWN repo only: ONE read per pass of
#                                          # .digby/branch-janitor/reviewed-deletes.json on default
#                                          # ({entries:[{branch, sha}]}, written by a branch review). A branch
#                                          # the rules keep (kept_active / kept_repushed / kept_unported /
#                                          # kept_port_unverified) is deleted as 'reviewed' only while its tip
#                                          # is the entry's exact 40-hex sha (moved = kept_review_stale); tip
#                                          # >= 48 h, archive required, every other keep/guard unchanged. To
#                                          # restore a 'reviewed' delete, remove its entry FIRST (else the next
#                                          # pass deletes it again). ON for 1 / true / on.
# DEEPSEEK_BALANCE_PROBE_DISABLED=1        # skip the hourly deepseek-balance-probe cron (GET
#                                          # api.deepseek.com/user/balance; is_available:false or HTTP
#                                          # 401/402/403 latches the DeepSeek utility leg + files the
#                                          # deduped owner-action ticket BEFORE a call fails)
# DEEPSEEK_BALANCE_WARN_FLOOR=1.00         # optional early warning: file a DISTINCT low-balance
#                                          # owner-action ticket when total_balance drops below this
#                                          # (default 0 = off; currency is the account's own, e.g. USD)
# SELF_MERGE_KEEP_HEAD_BRANCH=1            # merge_pull_request stops deleting the merged PR's head branch
# CAPACITY_WATCH_DISABLED=1                # kill the capacity watch entirely (todo 0f58ddde): the box-C
#                                          # capacity-probe cron (drainer pool + dev-container working-set
#                                          # memory → capacity_drainer_pool / capacity_dev_memory rows),
#                                          # the ticket drain's capacity_ticket_queue rows, the infra-watch
#                                          # sweep's capacity classifier ([INFRA ALERT — capacity] wakes)
#                                          # and the fleet [BOARD] capacity line all stop together.
# CAPACITY_DRAINER_OLDEST_MIN=60           # drainer-pool breach: alert only when EVERY slot is occupied
#                                          # AND the oldest parked drainer has drained ≥ this many minutes
#                                          # (default 60 — a fresh deploy wave's 4 parked drainers is normal)
# CAPACITY_DRAINER_CAP=4                   # the deploy-side drainer pool cap (WORKER_MAX_DRAINERS,
#                                          # deploy-coding-worker.sh) — default 4
# WORKER_MAX_DRAINERS=4                    # same as CAPACITY_DRAINER_CAP (deploy-script name wins if both)
# CAPACITY_DEV_MEMORY_PCT=90               # dev-container breach: alert at ≥ this WORKING-SET pct of the
#                                          # container's memory ceiling (page-cache-corrected; default 90)
#                                          # (same-repo, non-default heads are deleted after merged:true)

# ── THE send-mode resolver (audit 2026-09-26, platform/send-mode.ts — the web stream, REST / send_chat_message and Telegram share it) ──
# AUTO_ROUTE_ALLOWANCE_DISABLED=1        # the deep-research allowance is probed only under patience_auto_only (the old rule); default: on EVERY auto
#                                        # send, so an auto-routed Level 3 that cannot be reserved demotes to Ensemble instead of erroring
# SUPERVISOR_AUTO_RESEARCH_ENABLED=1     # a fleet / project supervisor chat may route / pick Level 3 on a human turn again (default: clamped to
#                                        # Ensemble, reasonKey supervisor_no_research — the council lead's profile / doctrine never replaces the supervisor's)
# MACHINE_DEEP_RESEARCH_FLOOR_DISABLED=1 # agent / schedule / hook sends keep an explicit / stored / routed Level 3 (default: floored to Ensemble,
#                                        # reasonKey channel_floor; webhooks stay floored; the chat-agent floors a machine-triggered deep_research too)
# PATIENCE_AUTO_ONLY_REST_DISABLED=1     # the REST / tool seam ignores patience_auto_only (SSE seam only, the old rule)
#                                        # reserve demotes to thinking, routing.clamped 'quota')
# TELEGRAM_AUTO_ROUTE_DISABLED=1         # Telegram sends run the fixed Level 1 again (default: routed like a web send, never Level 3 — chatless)
# ── Auto-path audit 2026-10-03 (each restores the pre-audit behaviour of ONE fix; all forwarded by docker-compose.app.yml) ──
# QUEUED_COUNCIL_QUOTA_DISABLED=1        # a busy-chat Level 3 send is queued WITHOUT reserving its deep-research slot (the drain then ran the council unmetered)
# AUTO_ROUTE_RESEARCH_CUE_SPLIT_DISABLED=1  # any research word ("source", "research", "cite", "latest news") routes to Level 3 again
# GUEST_CHECKER_GATE_BOUND_DISABLED=1    # a guest run (no chat row) blocks the lead for the Double Checker up to 300 s again (default: 75 s)
# STAKES_FINALIZE_WAIT_DISABLED=1        # a stakes / Dig-deeper verify plan whose lead answered at step 0 ships after the plain 10 s late-wait again
# ── Dynamic roster (docs/DYNAMIC_ROSTER_PLAN_2026-10-03.md; option B) ──
# AUTO_POOLS_DISABLED=1                  # every Auto pool follows its seats (quick → Quick answers, lead → Digby, checker → Double Checker, colleague → Double + Triple)
# TURN_PLAN_DISABLED=1                   # no turn_plan ask at all (the lane classifier; shadow by default — Account → Admin → Model roles → Decision gate sets act)
# QUICK_LANE_DISABLED=1                  # turn_plan in ACT never routes a turn to the Quick lane (the preset lead runs; the plan is still recorded)
# TURN_PLAN_LABELS_DISABLED=1            # no turn_plan outcome rows (Dig-deeper tap / re-ask / thumbs / the 30-min window close)
# DECISION_GATE_THRESHOLD_TURN_PLAN_QUICK=0.8  # p(quick) the Quick lane needs in act (both option orders averaged; clamped 0.5..1; 0.8 set by the 2026-10-03 replay)
# TURN_PLAN_QUICK_STAKES_CEILING=0.6     # stakes noul at/above this blocks the Quick lane (0..1; blank = default; Jev reads ~0.3–0.55 on ordinary messages)
# TURN_PLAN_QUICK_CONTESTED_CEILING=0.5  # contested noul at/above this blocks the Quick lane (0..1; blank = default)
# TURN_PLAN_QUICK_LOOKUP_STAKES_CEILING=0.75  # (2026-10-20) the Quick stakes ceiling for a PURE LOOKUP turn (needs_live_web ≥ 0.8, multi_step < 0.5,
#                                        # contested < 0.2 — quick-lane-guards.ts): the criteria-less stakes noul reads 0.52–0.73 on benign
#                                        # lookups (weather 0.62 was refused Quick); the ruler's band uses the same rule. A value ≤ the base
#                                        # stakes ceiling restores the base rule (0..1; blank = default). Not a switch — a forwarded numeric knob.
# TURN_PLAN_CANARY_DISABLED=1            # ignore the act canary allowlist (['instance','turn-plan']/config actCanaryUserIds — scripts/framework-audit/set-turn-plan-canary.js)
# AUTO_MODEL_PICK_DISABLED=1             # per-turn MODEL PICK off (platform/model-pick.ts — 2026-10-04: the decision picks the
#                                        # best MEASURED open model per standard / checked turn instead of the Digby seat;
#                                        # mode off|shadow|act in ['instance','turn-plan']/config `modelPick`, default shadow —
#                                        # scripts/framework-audit/set-model-pick-mode.js; shadow acts for the canary users only)
# MODEL_PICK_CHECKER_FAMILY_GUARD_DISABLED=1  # let the pick share the Double Checker's model family (default: a checked turn's lead is
#                                        # never the checker's family — model-pick.ts pickAvoidingFamily)
# ── Task-aware model pick (2026-10-20; platform/task-kind.ts; all forwarded by docker-compose.app.yml) ──
# TASK_KIND_DISABLED=1                   # no task_kind ask (the JOB a human turn is: writing / code / analysis / lookup / advice / planning /
#                                        # explain, asked beside turn_plan in both option orders) — the pick keeps today's (model, lane)
#                                        # evidence. The purpose is act-capped in code (a pure evidence key — DECISION_GATE_MODE_TASK_KIND below)
# MODEL_PICK_KIND_DISABLED=1             # no kind-aware pick at all — mode off|shadow|act in ['instance','turn-plan']/config `modelPickKind`,
#                                        # absent = shadow (records the kind pick beside today's (model, lane) pick); act lets a usable kind's
#                                        # pick replace the lane pick (scripts/framework-audit/set-model-pick-kind.js)
# MODEL_EVIDENCE_KIND_DISABLED=1         # model evidence ignores the bench's per-kind quality buckets ((model, lane) quality as before)
# QUICK_LANE_BRIEF_DISABLED=1            # a Quick-lane turn runs on the plain chat doctrine (default: + the lane brief — one search, answer from it; chat-agent/quick-lane-note.ts)
# FIRST_WORD_OPENER_DISABLED=1           # the first-word opener note is removed from the human-turn chat doctrine (default: on — open with one useful line before the
#                                        # the first tool call, so the first word never waits for the lead's web loop; ticket 4f7263e4, chat-agent/first-word-note.ts —
#                                        # the sse-adapter still delivers a first pre-tool segment a model writes on its own; Quick-lane turns and machine wakes never carry the note)
# VIDEO_CAPABILITY_NOTE_DISABLED=1       # a human turn whose message asks for a VIDEO loses its turn-scoped brief (default: on — that turn's doctrine orders the
#                                        # capability gap said in the FIRST line, then what Digby CAN make instead; other turns never carry it; the playbook's VIDEO
#                                        # row still stands; chat-agent/video-capability-note.ts)
# LIVE_CHAT_AUDIT_DISABLED=1             # no nightly live-chat audit (worker cron live-chat-audit, platform/live-chat-audit.ts — signals + decision replay over
#                                        # the last 24 h of REAL human turns, one deduped framework ticket per regression, loop_metrics live_chat_audit)
# LIVE_CHAT_AUDIT_TICKETS_DISABLED=1     # the audit reports (row + admin briefing line) but files no tickets
# LIVE_CHAT_AUDIT_REPLAY_SAMPLE=30       # turns re-asked to the turn_plan decision per night (segment 'replay', never pooled with human rows; 0 = off)
# LIVE_CHAT_AUDIT_JUDGE_SAMPLE=20        # of those, how many a reasoning judge (Utility seat, thinking on) rates (0 = off)
# LIVE_CHAT_AUDIT_QUALITY_SAMPLE=20      # real answers per night an answer-QUALITY judge scores 1..5 + an issue category (0 = off; no text stored)
# DECISION_GATE_DURABLE_DEMOTE_DISABLED=1 # no DURABLE act-band auto-demote in the 6-h readiness job (decision-gate-durable-demote.ts — the per-process
#                                        # window is wiped by every deploy; this rebuilds it from persisted outcome rows)
# DECISION_GATE_AUTO_ROLLOUT_MAX_TIER=1  # the rollout automaton flips tier 1 only and asks the owner about tier 2 (default 2 since 2026-10-04: a
#                                        # MEASURED-ready tier-2 purpose flips on its own — owner authorization; owner-locked purposes still ask)
# CHAT_LEAD_EFFORT_AB_DISABLED=1         # no lead-effort A/B (owner 2026-10-04): every human turn's lead keeps today's effort
# TURN_PLAN_LANE_RULE_DISABLED=1         # no shadow trait-adjusted lane (turn-plan.ts ruleAdjustedLane → metadata.depth.turnPlan.ruleLane / laneRule; routes nothing)
# XERO_ERROR_SURFACE_DISABLED=1         # a failed Xero API call degrades to '' again ("No result from Xero …"); default: the tool returns WHY (401/403 → reconnect Xero, 429, 5xx, network)
# INTEGRATION_ERROR_SURFACE_DISABLED=1  # the same for Slack / Asana / GitHub / Google / Plaid reads (integrations/integration-error.ts): a failed call degrades
#                                        # to '' again; default: ONE line — provider 401/403 → reconnect (exact Account → Integrations path), 429, 5xx,
#                                        # network, a connected user with no usable token, or the slack/asana/github/google-mcp CONNECTOR down (platform-side)
# CHAT_LEAD_EFFORT_AB_SHARE=0.5          # share of eligible HUMAN turns whose lead's already-sent reasoning_effort is CAPPED to 'high'
#                                        # (custom endpoints included; never adds the param; coding/effort-cap.ts). 1 = keep it for all, 0 = control only
# CHAT_ORPHAN_LATEST_RECHECK_DISABLED=1  # orphan sweeper Rule B re-fires on its SELECT snapshot alone (default: re-reads that the user row is STILL the
#                                        # newest after the busy probe — a run saves its answer before releasing busy; found 2026-10-04 by the query suite)
# ACTION_VERIFIER_FAILURE_REPORT_EXEMPT_DISABLED=1  # an honest failure report ("my browser task timed out") convicts again when only a FAILED
#                                        # attempt is on record (default: any attempted call of the claim's family vouches it; the extractor ignores failures)
#                                        # original row's ledger reads 'interrupted'; the requeue drain re-fires the rung)
# DELETED 2026-10-30 (RSW-1 delete-with-ledger, goal 393f731e): was
#   ESCALATION_STAMP_DISABLED=1 — NF_INERT (0 compose/Dockerfile hits), reader removed; the escalation rung ALWAYS gets its provisional running stamp at run start (a re-tap stays refused)
#                                        # while the rung runs; the finalize stamp replaces it with `done` + the rung's own spentUsd)
#                                        # config and refreshes in the background — the decision gate's request-path consumers never wait on it)
# FRONTIER_SEATS_REFUSE=1                # Seat governance (audit E3, 2026-09-27; review fixer same day) — OPT-IN refusal. Default OFF =
#                                        # OBSERVE-ONLY: a frontier-class custom-endpoint model (provider-class.ts: a frontier vendor host —
#                                        # anthropic.com / openai.com / openai.azure.com / generativelanguage|*-aiplatform.googleapis.com / x.ai
#                                        # — OR a proxy model id naming a CLOSED frontier family: claude / gemini / chatgpt / gpt-4+ / grok-3+;
#                                        # vendor prefixes alone never classify, and gpt-oss / gpt-2 / gpt-j / gpt-neox / cerebras-gpt / grok-1/2
#                                        # / gemma stay open) SAVES on the Digby / Fleet Supervisor / Project Supervisor / Double Checker / Triple
#                                        # Checker seats and their fallbacks — the seat is the owner's setting — badged "frontier" on the admin
#                                        # page with ONE loop_metrics seat_governance {role, spec, slot, outcome:'observed', probe} row. Set 1 and
#                                        # PUT /admin/model-roles (seats + fallbacks) REFUSES such a spec with a 400 naming this variable
#                                        # (outcome 'refused'); even then a PROBE (POST /admin/model-roles/test, the in-loop test_model_role) is
#                                        # never refused, and an owner-confirmed set_model_role_fallback card passes (outcome 'allowed_by_owner').
#                                        # Never consulted on the run path. (The first cut's FRONTIER_SEATS_ALLOWED is retired — not read.)

# ── Patience levels → always Auto (docs/PATIENCE_AUTO_ONLY_DEPRECATION_PLAN_2026-09-25.md; boot default OFF, PROD ROW = 1) ──
# PATIENCE_AUTO_ONLY=0             # BOOT DEFAULT for SystemSetting `patience_auto_only` (admin PUT /api/crossmodel/admin/settings/
#                                  # patience_auto_only flips it LIVE, 60 s cache — the SystemSetting row overrides this env). ON = every
#                                  # HUMAN send into a non-supervisor chat — web stream, REST / send_chat_message, Telegram (ONE resolver since
#                                  # 2026-09-26: platform/send-mode.ts) — is routed as 'auto' (the client's explicit level is kept as
#                                  # routing.requestedMode — a REST / mobile explicit level included; the web composer sends only
#                                  # 'auto' for a signed-in human since the 2026-10-06 picker retirement);
#                                  # guests are routed too, kept off Level 3); kids, supervisor chats, browser_agent and Dig deeper re-runs
#                                  # are never routed. Under the switch a Level 3 pick the sender cannot reserve is DEMOTED to Ensemble
#                                  # with routing.reasonKey (quota_exhausted / quota_unavailable — the allowance fails CLOSED on a Redis
#                                  # error / guest_no_research) instead of erroring.
#                                  # LIVE STATE: production has run the row at 1 since 2026-09-26 20:35Z (the compute-policy step-2
#                                  # rollout; the flip pre-dates the audit trail so its actor is unrecorded). Since the 2026-09-26 audit the
#                                  # PUT is validated (1|0|true|false|on|off), idempotent (changed:false writes nothing) and stamps the
#                                  # `patience_auto_only_by` companion row; Account → Admin → Settings → Depth policy is the UI;
#                                  # GET /admin/settings/patience-auto-only reads since/updatedBy; GET /depth/policy is the user-facing flag.
#                                  # (The web composer's depth picker and the Account → Advanced preset radios were RETIRED 2026-10-06 —
#                                  # roster B-3: the web client always sends 'auto' for a signed-in human and a preset is IGNORED by
#                                  # `depthPrefToWire`; since c99b404a (2026-10-27) the Advanced TAB is gone too and the remaining
#                                  # explicit-level senders are REST / mobile callers.)
# PATIENCE_AUTO_ONLY_HONOUR_PRESET=1    # OPT-IN (default OFF = every human send is Auto): under the switch a SIGNED-IN send carrying
#                                       # modeSource 'default' with a concrete level (today only a REST / API caller — mobile sends no
#                                       # modeSource and the web composer's preset radios were retired 2026-10-06, the Advanced TAB
#                                       # that stored web presets removed 2026-10-27, c99b404a) keeps its level —
#                                       # routingSource user_default, no router, no label window; guests / unsignalled sends and
#                                       # any 'picked' / 'restored' send are still routed (platform/send-mode.ts)

# ── Supervisor OFF switch (owner 2026-09-26; platform/supervisor-switch.ts) ──
# FLEET_SUPERVISOR_ENABLED=1       # BOOT DEFAULT for SystemSetting `fleet_supervisor_enabled` (unset = ON). The admin flips it LIVE —
#                                  # Account → Admin → Settings → Supervisors, or PUT /api/crossmodel/admin/settings/fleet_supervisor_enabled
#                                  # { value: '0'|'1' } — 60 s cache on every box; the SystemSetting row overrides this env. OFF = every
#                                  # machine wake of the Fleet Supervisor is skipped + counted (loop_metrics supervisor_switch; hook rows
#                                  # 'skipped:supervisor_off', never replayed on re-enable), no chat is created, spawns by it are refused,
#                                  # an in-flight run finishes, lanes and human turns are untouched. Fail-open: a read error reads as ON.
# PROJECT_SUPERVISORS_ENABLED=1    # Same for every per-project supervisor lane (SystemSetting `project_supervisors_enabled`; no lane is
#                                  # scaffolded while OFF; the per-project projectSupervisorEnabled flag is left as the owner set it).

# QUOTA_TRUSTED_PROXY_HOPS=        # the number of trusted proxies in front of Express (expected 2 = ALB + nginx). Gates the
#                                  # hops-anchored client-IP derivation (middleware/client-ip.ts peelClientIp) used by the guest
#                                  # deep-research quota key (quotaClientIp), the visitor IP hash, AND auth attribution
#                                  # (login-failure clientIpHash + the JWT spike-sample clientIp): the client becomes the
#                                  # X-Forwarded-For entry that many hops from the right — unforgeable by prepending. Unset =
#                                  # today's first-XFF-hop key (header-writable) and auth client fields are omitted.
#                                  # Guests stay off Auto-routed Level 3 (guest_no_research) until this is set and verified.

# ── Compute policy — depth as an outcome-driven policy, levels = presets (2026-09-26 wave; docs/DEPTH_UX_SOTA_2026-09-26.md "Implemented") ──
# Every new behaviour fails open to today's presets; each switch below restores the previous behaviour ON ITS OWN. The server switches are
# web-box process.env reads (A AND B — stage both, docs/REMOTE_OPS.md "Compute-policy switches"); the three gate PURPOSES are store-backed
# modes, not env (their DECISION_GATE_MODE_* lines further down are only the fallback).
# — gate (platform/compute-policy-gate.ts + platform/depth-budget.ts; names verified on cp/gate) —
# COMPUTE_POLICY_DISABLED=1        # decideComputePlan() returns the preset plan (source 'preset') without asking the gate
# COMPUTE_POLICY_TIMEOUT_MS=1200   # budget for the D0 ask at send (clamped 300..1200 — the user is waiting for the first token)
# STAKES_WAIT_MS=90000             # the ONE blocking path: a confident stakes ∧ contestable turn waits at most this long (clamped ≤ 300000) for the
#                                  # Double Checker at lead effort max (status key double_checking_stakes) before shipping + late-reconciling.
#                                  # Owner default 90 s (not the 300 s CROSS_CHECK_GATE_MS)
# RESEARCH_REQUEST_AUTOSTART_ENABLED=1   # audit 2026-09-26: a confident research_request may mark the plan council:'background' (DEFAULT OFF — no harness
#                                  # path consumes the marker; in act it only hid the Dig-deeper chip and made budget / labels claim a council)
# RESEARCH_REQUEST_AUTOSTART_DISABLED=1  # forces the marker off even when ENABLED is set
# COMPUTE_POLICY_MACHINE_ACT_ENABLED=1   # audit 2026-09-26: let a compute_policy ACT plan govern a machine / supervisor turn (DEFAULT OFF — the purpose's
#                                  # readiness is earned on human labels; without this an act plan on a machine lane is downgraded to shadow)
#                                  # 30 min after an untapped human answer (every 10 min, ≤200 rows/pass, rows ≤3 d old)
# DECISION_GATE_AUTO_DEMOTE_EXEMPT_PURPOSES=compute_policy  # purposes kept OUT of the per-process auto-demote window (default compute_policy — its labels
#                                  # are written by two processes; the 6-h DB-backed readiness ruler is its demotion path)
# CHECKER_ROUTE_LATE_LABEL_DISABLED=1    # audit 2026-09-26: keep the finalize-time checker_route label (default: deferred to the late reconcile's settle
#                                  # with checkerMerged upgraded, so heavy answer-first turns no longer label null)
# DRAFTS_AGREE_LATE_DISABLED=1           # audit 2026-09-26 (H3): the late reconcile no longer asks drafts_agree for a late draft (default: asked once)
# COMPUTE_POLICY_MACHINE_DISABLED=1      # 2026-09-26 (late, owner: "default all chats to auto even supervisors"): machine-triggered runs — supervisor /
#                                  # fleet-supervisor / project-supervisor wakes, schedule / hook / agent / webhook firings — never ASK the compute_policy
