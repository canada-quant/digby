# MACHINE_WAKE_CONTEXT_TIMEOUT_MS=15000          # 2026-09-14: getEnrichedContext deadline on MACHINE wakes (schedule/hook —
#                                                 # nobody waiting, deepHistory on). User turns keep the 5s fail-fast. A trip
