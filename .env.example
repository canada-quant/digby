# STAGED_CALL_RECEIPTS_DISABLED=1  # a confirmation-STAGED platform call leaves NO run_tool_receipts
#                                  # row again. Unset = an ok:false row with ids {staged:true,
#                                  # confirmationId} so get_run_receipts shows a lane parked on a
#                                  # card; never evidence (every reader filters ok:true) and excluded
#                                  # from the fleet guard tile's counts by a null-safe jsonb
#                                  # containment predicate (coding/run-receipts.ts, fleet.service.ts).
#                                     # executes WITHOUT minting a run_tool_receipts row again. Unset =
#                                     # the card execution mints the row the agent loop would have
#                                     # (ok per the tool result, runId null, ids.confirmationId +
#                                     # ids.ownerConfirmed:true) so the staged row is paired with its
#                                     # execution (confirmations.controller.ts).

