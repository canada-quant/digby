# SUPERVISOR_OWNER_STATE_READ_RETRY_DISABLED=1 # 2026-10-22: an owner answer on a supervisor chat that states live deployed / serving / running state with no read this turn is no longer re-run once with a "read it or say it was not read" check, and gets no "Harness check: this answer states live status that was not read in this turn …" line (the model-history strip of a stored line stays on)

# Ticket 0c647003 (2026-10-24): strip forged harness chrome — a "(harness)"-decorated ACTIONS TAKEN block
# and forged harness lines ("Reported up (harness): ...") — from a supervisor chat's OWNER-turn replies.
