# SSE_EARLY_HEARTBEAT_DISABLED=1      # streamQuery's 20 s ': heartbeat' starts after the routing / plan awaits again, not at the
                                      # header flush
# SSE_DROP_TELEMETRY_DISABLED=1       # no loop_metrics sse_viewer_drop / sse_reattach rows; the stream_drop / stream_resume ux
                                      # beacons record nothing (204)
# RATE_LIMIT_PATH_NORMALIZE_DISABLED=1  # the /stream and /upload rate limiters skip on the EXACT path again (/stream/ and /UPLOAD,
                                        # which reach the same handlers, go unlimited — middleware/rate-limit-paths.ts)
