# A blend over >MEM_SEARCH_WIDE_BLEND_SCOPES scopes gives EACH scope its newest
# MEM_SEARCH_WIDE_PER_SCOPE candidates (ROW_NUMBER partition) instead of one
# global recency cap — the owner's 34-project blend fetched ~4000 candidate
# embeddings (vec p50 3.7 s) to return the top 12; 16/project = ≤544 candidates.
# MEM_SEARCH_WIDE_BLEND_SCOPES=10    # how many scopes make a blend "wide" (floor 1)
# MEM_SEARCH_WIDE_PER_SCOPE=16       # newest rows each scope contributes (floor 1)
#                                             # (default: one attention_needed hook per session; cadence keeps firing as honest failed runs)

