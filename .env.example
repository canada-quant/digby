# AST_TOOLS_DISABLED=1                      # 2026-09-20 (harness roadmap item 3): ast_search / ast_rewrite run ast-grep
#                                           # inside the dev container via `npx --package @ast-grep/cli@<pin> ast-grep`
#                                           # (no image change; ~1 s cold, 0 s warm; never `sg` — the container's
#                                           # /usr/bin/sg is the group command). ast_rewrite = dry run → checkpoint
#                                           # every touched file → --update-all → diagnostics + post-edit hooks.
#                                           # Set =1 to refuse both tools (honest note; grep/edit_file remain).
# AST_GREP_VERSION=0.45.3                   # Pin override for the npx package (semver triple only).
# EDIT_DIAGNOSTICS_DISABLED=1               # 2026-09-19 (harness roadmap item 1): after edit_file/write_file a
#                                           # top-level coding run gets a debounced BACKGROUND typecheck (the
#                                           # project's tsc made --incremental, cache in /tmp) + file-scoped lint,
#                                           # injected as ONE [DIAGNOSTICS] note on its next turn — errors in the
#                                           # touched files first, others as a count. Informational; verify stays
#                                           # the check of record. loop_metric edit_diagnostics. Set =1 to disable.
# TOOL_BATCH_CAP_DISABLED=1                 # 2026-09-20 (autonomy loop #9): a model turn runs at most TOOL_BATCH_CAP
#                                           # (default 24) tool calls; the rest get a synthetic '[HARNESS — not
#                                           # executed]' result, and a turn ≥80% one tool counts as a repeat-break
#                                           # trip for it (1 round → 3 rounds → the rest of the run). Run 1cf6f9d4:
#                                           # 233 + 327 update_feedback refusals in two single turns. loop_metric
#                                           # tool_batch_cap. Set =1 for the uncapped loop; TOOL_BATCH_CAP tunes.
#                                           # verify chain runs the tests that import the changed files
#                                           # (`jest --findRelatedTests` / `vitest related`) as a `test:related`
#                                           # stage — a failing subset stops the chain in seconds; a green subset
#                                           # never replaces the full stage. loop_metric verify_related. Set =1 for
#                                           # the plain full-suite chain.
# WEB_HEDGE_DISABLED=1                      # 2026-09-19 (autonomy loop #7): when the DIRECT BrightData search/scrape
#                                           # call has not answered within WEB_HEDGE_MS (default 12000), the MCP
#                                           # gateway call starts in parallel and the first useful answer wins — the
#                                           # direct tier timed out 67× in 4 h (45–60 s each) before falling back.
#                                           # Deterministic empties still skip the gateway. loop_metric web_fetch_path.
#                                           # Set =1 for the sequential direct-then-gateway order; WEB_HEDGE_MS tunes.
#                                           # nothing in 35 % of prod searches and each miss cost ~17–24 s before the
#                                           # gateway (which answered every time) even started. A rolling window of
#                                           # direct outcomes per tool (noted when the direct call SETTLES, whoever won)
#                                           # drops the hedge trigger to WEB_DIRECT_ADAPTIVE_HEDGE_MS (default 0 =
#                                           # race both tiers at once; direct still wins when it lands first) while the
#                                           # miss rate over the last WEB_DIRECT_ADAPTIVE_WINDOW (40) calls exceeds
#                                           # WEB_DIRECT_ADAPTIVE_MISS_RATE (0.3) with ≥ WEB_DIRECT_ADAPTIVE_MIN_SAMPLES
#                                           # (20). search_engine only. Every web_fetch_path row now carries hedgeMs /
#                                           # adaptive / directMissRate and, on a direct miss, directClass (timeout |
#                                           # empty_body | serp_<consent|captcha|redirect|json_no_organic|…> |
#                                           # upstream_<code> | http_<status> | net_<code>); a gateway-first win adds
#                                           # one late row {phase:'direct_settled'} naming what direct would have done.
#                                           # Set =1 for the fixed WEB_HEDGE_MS trigger (WEB_HEDGE_DISABLED=1 also
#                                           # disables it — it is a hedge variant). The class telemetry is unconditional.
# EDIT_CHECKPOINTS_DISABLED=1               # 2026-09-19 (harness roadmap item 7): every write_file / edit_file on
#                                           # a top-level coding run snapshots the file's prior content per loop
#                                           # step (OS temp dir of the worker, ≤400 snapshots, ≤2 MB each);
#                                           # rewind_to_step({step}) restores every file changed at that step or
#                                           # later (created files removed) — the agent's own edits only. Call
#                                           # without step to list. loop_metric edit_checkpoint_rewind. Set =1
#                                           # to run without checkpoints (the tool answers 'not available').
#                                           # carries ONE dated standing block "What changed 2026-09-25/26" (decision gate
#                                           # act purposes, staged receipts, computer-use facts, deploy/DMG ops facts;
#                                           # ≤1,200 chars, supervisor-doctrine.ts fleetChangelogNote) until an owner
#                                           # retires it. =1 removes the block (the stock prompt heals to the shape
#                                           # without it); the durable "Harness facts" section stays either way.
# ── KPI of record + adoption ladder (tt-rd audit 2026-09-27, "kpi-honesty-loops") ──
# Why: over 14 days the tt-rd supervisor reported 7.3 / 6.56 / 5.08 tok/s to the
# owner as "the" serving rate (an internal timer, a derived ratio, the probe); the
# register's one KPI slot flapped 5.364→2.464→5.08 in 14 h; 273/280 PRs were docs
# folds that counted as "moved toward a goal"; a 4.5-day / 27-firing ladder with
# 0 adoptions tripped no detector. All observe-only except the one deterministic,
# cheap refusal (a kpi: premise needs a receipt that exists). Docs: AGENTS.md
# 2026-09-27 kpi-honesty-loops bullet.
#                                           # goals.service skips the receipt-row check; the "Mission KPI contract"
#                                           # doctrine block is omitted from both supervisor prompts (heals on toggle).
#                                           # Every refusal of the contract is a loop_metrics kpi_premise_refused row
#                                           # {gate:'kpi_contract', reason} (2026-09-27 fixer follow-up) — no separate switch.
#                                           # [SUPERVISOR STATE] project line that types a KPI rate / names the key.
#                                           # the brief prompt, no typed-rate replacement in the brief's now/next.
#                                           # status card KPI row or the lane's [SCHEDULE STATE]; no [NO-ADOPTION]
#                                           # wake (platform/adoption-ladder.ts; runs inside the attention-watchdog sweep).
# ADOPTION_LADDER_K=8                       # completed work sessions since the last receipted KPI move that trip the wake —
#                                           # ALSO the per-lever budget default both supervisor doctrines name (kpi-of-record.ts)
# ADOPTION_LADDER_HOURS=48                  # …or hours since it, only with ≥ 1 completed experiment in the window (an idle
#                                           # goal, a BLOCKED goal or a goal at its bar never trips; deduped 24 h per goal in
#                                           # Redis and re-sent only on NEW evidence — a higher count or a fresh ladder)
#                                           # supervisor prompts (budget per lever, close-the-ladder, schedule-prompt hygiene).
#                                           # older than 7 days move to the doc's `archived` list (oldest first) while
#                                           # the live ledger holds > 10 open rows — the Fleet Supervisor carried 44
#                                           # open rows (35 > 7 d) the evidence-gated close could never retire, hiding
#                                           # ~40 from every wake. Nothing is deleted: get_supervisor_state reads the
#                                           # archive, update_supervisor_state {id, status:'open'} revives a row.
#                                           # loop_metric directive_archive. Set =1 to keep every row live.
#                                           # supervisor directive with NO evidence recorded gets (a) a
#                                           # [FOLLOW-THROUGH — DIRECTIVE] direct wake at 24 h naming it (one per
#                                           # directive per 24 h, ≤5 folded into one wake, Redis SET NX dedupe —
#                                           # a Redis failure fires nothing), (b) a DIRECTIVE AGE ALARM line in the
#                                           # [SUPERVISOR STATE] block at 48 h (archived-but-open rows count) and
#                                           # (c) ONE loop_metric directive_open_age row per supervisor chat per
#                                           # day (value = oldest evidence-less age in hours). The wake asks for the
#                                           # dispatch id AS EVIDENCE on the OPEN row ({id, evidence:'dispatched:
#                                           # session <id>'}) and a close only once the artifact landed (VERIFY
#                                           # BEFORE DONE); recording a blocker as evidence the same way clears the
#                                           # alarm without closing. =1 removes all three (platform/directive-age
#                                           # .service.ts rides the attention watchdog; the line lives in
#                                           # supervisor-state.service.ts).
# DIRECTIVE_AGE_WAKE_MAX_PER_DAY=1          # 2026-09-27 (D2 review fix): [FOLLOW-THROUGH — DIRECTIVE] wakes per
#                                           # SUPERVISOR per 24 h (Redis INCR + EXPIRE). They are alarm-class
#                                           # todo_wake rows — they bypass the N/day machine-run cap — so without
#                                           # this a ledger of N evidence-less rows meant ceil(N/5) alarm runs a
#                                           # day 15 min apart. Default 1 (the alarm line carries the rest of the
#                                           # ledger every wake); 0 = never wake, still measured. A withheld wake
#                                           # is ONE directive_follow_through {outcome:'capped'} row per
#                                           # supervisor per day.
# DIRECTIVE_AGE_WAKE_RAMP_MS=172800000      # 2026-09-27 (D2 review fix): first-deploy ramp — for this long after
#                                           # the sweep's first run (Redis key directive-age:live-since, SET NX)
#                                           # only the alarm line + daily metric run; no wake over the pre-existing
#                                           # open ledger (prior doctrine never asked for evidence on OPEN rows,
#                                           # so every old row qualifies at once). Default 48 h; 0 disables.
#                                           # Withheld = ONE directive_follow_through {outcome:'ramp'} row per
#                                           # supervisor per day. An unreadable stamp counts as in-ramp.
#                                           # it can be found and found nowhere is OBSERVED — receipt/run ids
#                                           # against the closing chat's own run_tool_receipts rows (id + ids,
#                                           # last 30 d) + its dispatch ledger; a pr number ACCOUNT-wide against
#                                           # any ok receipt of this owner carrying ids.prNumber (the
#                                           # open_pull_request receipt a lane minted — a supervisor never opens
#                                           # a PR itself); deploy ids are NOT matched at all (nothing persists a
#                                           # deploy run — format-only, as before). The close lands, the applied
#                                           # ack reads "closed UNRECEIPTED (observed only — the close stands)",
#                                           # one loop_metric directive_close_unreceipted row {directiveId, refs,
#                                           # outcome, matchable:true, scope:{<type>:'chat'|'account'}}. =1
#                                           # removes the check. (Review fix: the first cut matched receipt HEADS
#                                           # the DB never persists, so every PR#/deploy close read unreceipted.)
#                                           # into errors instead (outcome 'rejected'). Default OFF (gate-flip
#                                           # doctrine 2026-09-11: observe-only on a lane's own work). Fail-open:
#                                           # a receipts / probe read error never blocks a close. Do NOT flip it
#                                           # while a cited type is unmatchable: a PR opened outside the framework
#                                           # (the owner, a GitHub connector tool) mints no receipt and would be
#                                           # unclosable — read directive_close_unreceipted for a week first.
# WORKER_SEAT_ROUTING_DISABLED=1            # 2026-09-19 (harness roadmap item 4): the reviewer/cross_checker,
#                                           # planner/architect and explorer/web_researcher WORKERS a lane delegates
#                                           # to run on their own model-roles seats (Reviewer follows the Double
#                                           # Checker by default = an independent review model; Architect/Explorer
#                                           # unset = the lane's own model). An explicit model on the delegate call
#                                           # still wins. loop_metric worker_seat_route. Set =1 for the pre-seat
#                                           # tier rule on every worker.
# ── 2026-09-27 seat/provider limits (the gpt-6-astra incident: the Fleet Supervisor seated on a custom
#    LiteLLM model 400'd EVERY turn for 6 h — 195 tools on a 128-tool OpenAI cap, then a proxy-injected
#    reasoning_effort refused with tools; the harness retried the same model 48× instead of trimming / re-seating)
# CUSTOM_ENDPOINT_TOOLS_MAX=                # OPT-IN blanket tool cap for custom-endpoint models with NO known cap. UNSET
#                                           # (the default since 2026-09-27 late — "who said 128 is the limit??") means
#                                           # NO blanket: the b085607e default of 128 is GONE (it trimmed a Kimi K3 behind
#                                           # the api-optimize proxy 196 → 128 though that model never rejected a tool
#                                           # list; the row said "learned" for a cap nobody learned). A cap now comes ONLY
#                                           # from the registry (model.maxTools > endpoint settings.maxTools > the
#                                           # DOCUMENTED provider class: openai 128, google 512 — moonshot / deepseek / zai
#                                           # / dashscope / anthropic document none = unlimited), a cap LEARNED from a
#                                           # live 400 body, or this env. Telemetry `source` is honest: model | endpoint |
#                                           # class | learned | blanket. Built-ins are never capped.
# TOOL_GROUPS_DISABLED=1                    # 2026-09-27 late, PROGRESSIVE TOOL DISCLOSURE (coding/tool-groups.ts): when a
#                                           # REAL cap binds (or TOOL_GROUPS_ALWAYS=1) the model sees a small always-on
#                                           # CORE (≤96: files/shell/git/plan/web/docs/delegation/chat messaging/schedules/
#                                           # goals/receipts) + the groups the task text obviously needs + two gateway
#                                           # tools — list_tool_groups / load_tools({group|query}) — and loads the rest on
#                                           # demand (LRU eviction under the cap; a tool called by name is auto-loaded,
#                                           # never an unknown-tool refusal; loaded state persists across the run; ONE
#                                           # loop_metric tool_groups {cap, core, inView, loaded[], evicted[], autoLoads}
#                                           # + AgentRunResult.toolGroupsLoaded; live-run status "Tool groups: core + X").
#                                           # Set =1 to restore the priority trim below byte-for-byte.
# TOOL_GROUPS_ALWAYS=1                      # opt-in UNIVERSAL progressive disclosure — core + groups on every seat, built-ins
#                                           # included, with no cap (token savings: a ~200-tool schema is ~55k tokens/turn).
# TOOL_LIMIT_TRIM_DISABLED — DELETED 2026-11-02 (RSW-1, goal 393f731e). Its default WAS the live behaviour: the
#                                           # PRIORITY ORDER (core + doctrine tools first, connector writes dropped first —
#                                           # coding/provider-limits.ts) is now unconditional, and the plain first-N shape
#                                           # survives only as an explicit caller opt-in (trimToolsToLimit opts.plain), never
#                                           # from the environment. A real cap never switches off. loop_metric tool_list_trimmed
#                                           # per (run, model) still records the honest `source`; its meta.mode is now always `priority`.
# SEAT_INVALID_REQUEST_FALLBACK_DISABLED=1  # a custom-endpoint LEAD seat that 400/404/413/422s with a deterministic
#                                           # fingerprint (tools too long, reasoning_effort refused, tools unsupported,
#                                           # unknown param, model not found, context too long) moves the run to the
#                                           # seat's custom fallback / the built-in order AT ONCE (the 429 cooldown's
#                                           # path) and is LATCHED so no later run on this process retries it —
#                                           # seat_fallback rows carry fingerprint + latchedUntil; the admin Model roles
#                                           # page, the owner briefing and the project status card state "seat X unusable:
#                                           # <reason> — running on Y since <t>". Set =1 for the pre-change lanes
#                                           # (the capability regex now fails those 400s FAST instead of 7 retries).
# SEAT_INVALID_REQUEST_LATCH_MIN=30         # latch window in minutes (0 = no latch; the fallback still fires).
#                                           # entry says 'supported'; on the exact "reasoning_effort … not supported" 400
#                                           # the turn is retried ONCE with reasoning_effort:'none' and the model latched.
#                                           # LiteLLM fix for OpenAI reasoning models: `reasoning_effort: none` under
#                                           # litellm_params for the model group, or route it via /v1/responses.
#                                           # /:id/detect[/:modelId]): the bounded probe suite (≤4 models at once, 20 s per
#                                           # probe) that SETS a model's flags with evidence — chat stream shape, tool
#                                           # calling, max tools, reasoning_effort, thinking-by-default, vision, embeddings
#                                           # dims (MRL), rerank, typed decisions, image generation, context window.
# PROVIDER_COOLDOWN_DISABLED=1              # 2026-09-19 (autonomy loop #3): a model PROVIDER that rejects 3 lead
#                                           # turns with 429/5xx inside 120 s trips a 180 s process-local cooldown;
#                                           # lead seats on it start on / stay on their fallback seat instead of
#                                           # paying a rejected round trip every step (Z.AI storm: 210 wasted
#                                           # calls in 3 h). loop_metric provider_cooldown per trip. Set =1 to
#                                           # re-probe the chosen seat every step (the pre-breaker behaviour).
# CODING_SEAT_FALLBACK_DISABLED=1           # 2026-09-17 (ticket fe6f0b0b): a coding run whose MAIN seat burns
#                                           # the whole transient backoff budget (429/5xx/connection — e.g. a
#                                           # spark LiteLLM gateway 500ing through a deploy window) fails over
#                                           # for the rest of the run to the admin's coding_default custom
#                                           # fallback, then (custom-endpoint seats) the built-in glm-5.3 —
#                                           # progress event + transcript note + seat_fallback telemetry, never
#                                           # silent. Set =1 for the old fail-hard terminal note.
# LEAD_SEAT_FALLBACK_DISABLED=1             # 2026-09-16: the LEAD (coding_default) seat's IMMEDIATE fallback
#                                           # lanes — an unreachable custom endpoint (ECONNREFUSED / ENOTFOUND /
#                                           # EAI_AGAIN / EHOSTUNREACH falls back at once; a timeout / reset
#                                           # after ONE ordinary backoff already burned) and HTTP rejections
#                                           # (429/5xx/billing) — are on by DEFAULT. Set =1 to keep the old
#                                           # honest give-up instead of failing over. Also implied by
#                                           # CODING_SEAT_FALLBACK_DISABLED=1: an operator who disables seat
#                                           # fallback means ALL of it. Forwarded to backend + worker, so it is a
#                                           # per-box hard stop while a bad provider is triaged (no deploy needed).
#                                           # Read through the on() helper in coding/helper-seat.ts.
#                                           # detector scores the final assistant text (4-signal conjunction:
#                                           # script-mix chaos, token-glue collapse, no sentence structure,
#                                           # word collapse) and, when EXTREME degenerate (the multilingual
#                                           # token-soup a broken provider emits), STAMPS the persisted row
#                                           # metadata.outputDegenerate + a degenerate_final loop metric. It is
#                                           # strictly detect-and-mark — content is delivered byte-identical,
#                                           # never replaced/quarantined/retried. Set =1 to turn the rail off.
# PROJECT_STATUS_UPDATES_DISABLED=1         # 2026-09-14: stop the hourly deterministic project status
#                                           # card every project supervisor posts (metadata.origin project_status)
#                                  # has a project supervisor, the Fleet Supervisor's wildcard receives only
#                                  # ALARM-class events from it (run_completed/todo_done fan into the project
#                                  # lane, which reports up). Metric hook_quiet_event_shed.
#                                  # (≤10 quiet rows per window). Unset = the hook that wins its
#                                  # debounce window drains its whole backlog into ONE digest wake.
