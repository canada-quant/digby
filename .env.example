# ── Feedback tickets — backlog audit 2026-09-28 (feedback/feedback.service.ts, feedback/ticket-status.ts, feedback/closure-manifest.ts) ──
#                                          # (24 h, same user). Default: an agent-captured owner remark that matches one
#                                          # (normalized title exact / Jaccard ≥ 0.6 / title contained) is filed as a LINKED
#                                          # DUPLICATE — status done, context.duplicateOf, autoDispatch:false — recorded but
#                                          # never dispatched; the user row is read only, never written. Off = the pre-audit
#                                          # path (the twin filed as a fresh open row and dispatched to a second lane).
#                                          # matches 'done' only. Default: a legacy closed spelling ('resolved', 'closed', …)
#                                          # READS as 'done' (list_feedback / get_feedback / the Account Feedback tab / admin
#                                          # listing), ranks with done, and the reopen scan + closure manifest treat it as closed.
#                                          # Rows are never rewritten by the runtime — scripts/framework-audit/
#                                          # backfill-ticket-status-done.js (dry-run default, --apply, --revert) folds them.
#                                          # proving the fix live. Default: the entry waits (unclaimed, retried every 10-min
#                                          # sweep) until fix-state.ts proves the commit merged to origin/main AND the deploy
#                                          # green / a box running it; the adminNote then carries the [machine-close evidence]
#                                          # block. On demand: scripts/framework-audit/apply-closure-manifest.js via prodq.sh
#                                          # (dry-run default reports wouldClose + pending reasons; --apply = the cron's write).
# ── Telemetry noise + small correctness (2026-09-28 backlog audit, branch backlog/telemetry-noise) ──
# CODING_CONTAINER_PROBE_DISABLED=1        # this process never probes Docker: no `docker info`, no "fail closed" warn — one info
#                                          # line "Docker probe skipped … session commands route to the coding box over Redis".
#                                          # For the web-tier backends (boxes A/B, whose DOCKER_HOST names a dead proxy by design).
#                                          # A process with CODING_WORKER_CONCURRENCY=0 (the box A cron-only workers) skips the
#                                          # same way without this flag. Boxes with worker slots keep the probe + warn as before.
# CODING_CONTAINER_PROBE_SKIP_DISABLED=1   # restore the probe (and its warn) on EVERY process, the two signals above ignored.
# DOCKER_REPROBE_RETRY_DISABLED=1          # a healthy daemon's 60 s re-probe gets ONE try again (no quiet retry before 30 s of fail-closed), pre-2026-10-20
# CODING_HOST_EXEC_FAIL_CLOSED_DISABLED=1  # container mode: the provision dep install + live preview curl fall back to bash on THIS host again, pre-2026-10-20
# BUSY_SKIP_ALARM_WARN_ALL=1               # the busy-skip alarm LINE at warn on every crossing again. Default: info for the
#                                          # tolerated cases (the 3-skip level; a plain-chat lane's own turn holding the lane —
#                                          # "a run outside agent_runs"), warn only for a ≥10-skip crossing with a named blocker
#                                          # (a live run / a stuck coding-session row). The busy-skip warn fires at
#                                          # every crossing regardless (metric removed by S-2 2026-10-08).
#                                          # bad input de-embedded up to 10 rows). Default: re-embed row by row so the good rows
#                                          # keep their vectors. The cause (status, provider code + message, rows, maxChars,
#                                          # source, scope) is logged ONCE per cause per process at warn (then debug) and counted
#                                          # as loop_metrics unified_memory_embed_failed either way.
# UNIFIED_MEMORY_EMBED_ROW_RETRY_MAX=20    # rows re-embedded one by one per store after a rejected batch (each call 8 s bounded).
#                                          # context carries `ip` (req.ip — honours trust proxy) + `emailHash` (sha256 prefix,
#                                          # never the address) and one loop_metrics auth_login_failed {ipHash, emailHash} row
#                                          # is recorded, so a password-guessing burst from one client is distinguishable.
# UNIFIED_MEMORY_EMBED_429_RETRIES=2       # 429-aware backoff (ticket d7bf73c2): retries a THROTTLED embed batch after a
#                                          # backoff — the provider's Retry-After when it fits the 10 s in-call budget (a cap
#                                          # PER WAIT and CUMULATIVELY across retries), else 0.75 s → 1.5 s exponential,
#                                          # cap 2 s. 0 = off. A Retry-After longer than the budget skips the in-call retry
#                                          # (the rows land NULL immediately and the memory-embed-backfill cron repairs
#                                          # them). Default 2.
# UNIFIED_MEMORY_EMBED_429_RETRY_DISABLED=1 # kill switch: a throttled batch is never retried in-call (pre-d7bf73c2 behaviour).
# MEMORY_EMBED_BACKFILL_DISABLED=1          # kill switch for the memory-embed-backfill cron (ticket d7bf73c2): the 15-min
#                                          # repair pass that re-embeds NULL-embedding digby_memory rows (stops the row loop
#                                          # on a 429 — never feeds the throttle it repairs — and bounded to 8 min < the
#                                          # 10-min cron lease).
# MEMORY_EMBED_BACKFILL_BATCH_SIZE=50       # NULL rows re-embedded per backfill tick (1..200; default 50).
# MEMORY_EMBED_BACKFILL_MAX_AGE_DAYS=120    # rows older than this stay keyword-only forever. Was 7; raised 2026-11-01 after measuring NULL rows up to ~95 days old that a 7-day window could never reach.
# RAG_EMBED_AUTHORITATIVE_SPEC=            # Optional pin (e.g. dashscope:text-embedding-v4) forcing the REPAIR target's vector space. Default: resolve the same embeddings seat the LIVE QUERY leg uses (parity with queries), falling back to DashScope text-embedding-v4 when the seat does not resolve.
# (no switch) a ZodError thrown inside a handler is logged at the status the client gets — warn / 400 (was error / 500);
#             `token`-class query credentials are redacted from the logged url (`?token=[redacted]`); the per-turn
#             "runModelTurn: tools trimmed" line is info ONCE per (endpoint, model) per process and the agent loop's
#             once-per-run trim line is info (the tool_list_trimmed metric is unchanged).
# ── Coding view_image tool (2026-10-01 — coding/view-image.ts; image-describe.ts answerImageQuestion) ──
# VIEW_IMAGE_TOOL_DISABLED=1               # drop view_image from every coding run's tool list (and its system-prompt line); a
#                                          # by-name call is refused. Default: lanes LOOK at an image file (PNG/JPEG/GIF/WebP/
#                                          # BMP/HEIC, ≤6 MB, read through the session shell) via the Image reader seat
#                                          # (vision_describe) instead of rebuilding vision from pixels.

# ── Production audit fix wave 2026-10-06 (canonical: the 2026-10-06 audit bullet in AGENTS.md) ──────────────
# Every switch below is UNSET by default = the fixed behaviour; `=1` restores the pre-audit behaviour byte-for-byte.
# T1 context / compaction / memory / seat fallback
# REGISTRY_CONTEXT_FAMILY_DISABLED=1          # gateway models with no contextWindow get the 160k-char default again (default: the built-in family's window — glm-5.3 4M chars, glm-5.3-flash 400k, kimi-k3 800k, deepseek-flash/v4 4M)
# CAPABILITY_DETECT_LITELLM_MODEL_INFO_DISABLED=1  # Detect capabilities skips LiteLLM /v1/model/info max_input_tokens
# COMPACTION_STEER_PIN_DISABLED=1             # compaction strips owner/supervisor steers again (default: newest 3 kept verbatim)
# MEMORY_READ_REOFFLOAD_SKIP_DISABLED=1       # search_memory / list_memory results are stored back into session memory again
# MEMORY_SESSION_DEDUPE_DISABLED=1            # session memory stores duplicate chunks (same source + ref) again
# MEMORY_CEILING_TIERED_EVICTION_DISABLED=1   # the 6000-row session memory ceiling evicts pure newest-first again (no hit / fresh / unique-record tiers)
# SEAT_FALLBACK_SAME_ENDPOINT_LAST_DISABLED=1 # on a gateway 502/503/504 try the admin fallback order as-is (set this on BENCH boxes: owner's gateway-only rule)
# NO_PROGRESS_BRAKE_DISABLED=1                # no harness notice after N calls without a mutation
# NO_PROGRESS_BRAKE_CALLS=80                  # calls without a mutation before the one notice (min 10)
# FINAL_TURN_CHECKPOINT_DISABLED=1            # every continuation round ends on the final-report notice again
# INTENT_MEASURE_SYSTEM_EXCLUDE_DISABLED=1    # tool_intent_attribution measurement reads the system prompt again
# T2 secrets
# SECRET_SCAN_PASSWORD_LABELS_DISABLED=1      # drop the password / passphrase / plain-English credential shapes (redaction-only; commit gate unchanged)
# SECRET_SCAN_APP_PASSWORD_PROSE_GUARD_DISABLED=1  # a 4x4 run of ordinary English words near a gmail/smtp/secret cue is redacted again (hotfix 2026-10-06)
# OUTBOUND_SECRET_REDACT_DISABLED=1           # send_chat_message / notify_user bodies sent verbatim again
# STORE_SECRET_TOOL_DISABLED=1                # store_secret refuses (owner-pasted keys → encrypted coding credential $ENVKEY)
# OWNER_SECRET_DELIVERY_DISABLED=1            # flag_owner_question deliverSecrets refuses + implicit span rescue off (owner cards redact credentials at write time again — ticket 26786762). The consoleAction.payload credential refusal and the consoleUrl echo refusal are switch-independent (fail-closed spec defects).
# T3 hooks & wakes
# WAKE_TRIAGE_PARK_RIDE_DISABLED=1            # parked wakes deliver alone again at retryAt / turn end
# WAKE_TRIAGE_MAX_HOLD_MIN=120                # max hold of a parked wake from the first park (30..1380)
# HOOK_FLEET_SHED_PS_ANY_TOGGLE_DISABLED=1    # Fleet wildcard gets a project supervisor's quiet events when its toggle is off
# HOOK_FLEET_SHED_PLAIN_CHAT_DISABLED=1       # Fleet wildcard gets run_completed from plain personal chats
# HOOK_FLEET_SHED_DIRECT_COVERED_DISABLED=1   # direct per-chat hooks into the Fleet fire even when a project-supervisor hook covers the chat
# HOOK_SUMMARY_SECRET_REDACT_DISABLED=1       # hook summaries stored/delivered unredacted
# HOOK_SCHEDULE_DISABLED_ACTOR_SHED_DISABLED=1  # a supervisor's own schedule cancel still wakes the Fleet
# HANDOFF_PS_COVERED_SKIP_DISABLED=1          # a human parent is machine-woken for an un-posted child result even when a PS covers it
# HOOK_REPORTED_IN_RUN_SKIP_DISABLED=1        # run_completed wakes even when the run already messaged the target
# HOOK_SOURCE_ARCHIVED_SKIP_DISABLED=1        # archived chats keep emitting hook events
# NOTIFY_USER_DEDUPE_DISABLED=1               # notify_user near-duplicates are pushed again
# NOTIFY_USER_DEDUPE_WINDOW_MIN=360           # dedupe window (minutes)
# NOTIFY_USER_DEDUPE_SIMILARITY=0.7           # token-hash similarity for a near-duplicate
# NOTIFY_USER_DISMISSED_GUARD_DISABLED=1      # notify_user may re-raise a question the owner dismissed
# NOTIFY_USER_KPI_REANNOUNCE_DISABLED=1       # notify_user may re-announce a KPI whose of-record state is unchanged (ticket abca56ce)
# NOTIFY_USER_KPI_REANNOUNCE_THRESHOLD=0.10   # fraction of the last-announced KPI value within which a move is not news
# NOTIFY_USER_KPI_REANNOUNCE_WINDOW_MIN=360   # how long a remembered KPI announcement state is honored (minutes)
# OWNER_DISMISS_RETRY_QUESTION_KEY_DISABLED=1 # dismiss retry keyed by the chat id again
# FOLLOW_THROUGH_ACTED_SINCE_DISABLED=1       # follow-through auto-files questions for work already moving
# WATCHDOG_DEAF_LANE_FIX_DISABLED=1           # a lane with a running run can be "deaf"; one item per todo
# SUPERVISOR_HOOK_TEMPLATE_HEAL_DISABLED=1    # stale schedule ids in supervisor hook templates are not healed
# T4 schedules & supervisor cadence
# WATCHDOG_RECURRING_CADENCE_DISABLED=1       # one-shot schedules set the zombie / deaf floors again
# SCHEDULE_DISABLED_ACTOR_DISABLED=1          # schedule_disabled carries no actorChatId
