# SWITCHES (build 2026-10-08 S): backend/src/modules/crossmodel/platform/switch-registry.ts is the ONE list of every env switch the code
# reads; CI fails on an unregistered / unforwarded / expired switch. A switch only works in prod if docker-compose.app.yml forwards it.
# 280 inert switches were deleted — a name mentioned in a comment below with no line of its own is gone (the registry ledger lists them).

# Database
DATABASE_URL=postgresql://admin:password@postgres:5432/admin_db?sslmode=disable
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=admin_db

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Google OAuth & Workspace MCP Integration (optional)
# Set up at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Gmail API, Calendar API, Drive API, Google Docs API, Sheets API
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://digby.ai/api/crossmodel/google/callback
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-here-64-chars-total-abcdef1234567890
# Shared secret for backend → google-mcp container (generate strong random key)
GOOGLE_MCP_API_KEY=your-google-mcp-api-key-here
# Internal Docker URL (backend → google-mcp container via Docker network)
GOOGLE_MCP_URL=http://google-mcp-prod:8000/mcp

# GitHub OAuth & MCP Integration (optional)
# Set up at: https://github.com/settings/apps → New GitHub App
# Callback URL: https://digby.ai/api/crossmodel/github/callback
# Permissions: Contents (read/write), Issues (read/write), Pull requests (read/write), Metadata (read)
GITHUB_OAUTH_CLIENT_ID=Iv23li...
GITHUB_OAUTH_CLIENT_SECRET=your-github-app-client-secret
# Generate with: openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-here-64-chars-total-abcdef1234567890
# Optional kill switch (default: fallback ON): when a project's pinned githubLabel matches
# no connected account row, getValidToken falls back to the first-connected account with a
# warn (FO f121-hook 2026-10-12 — a reconnect under new labels had refused all pushes
# fleet-wide with no log line). Set to 1 to restore the old hard failure.
#GITHUB_LABEL_FALLBACK_DISABLED=1
# Warn-latch window for that fallback, ms (ticket e1cca01d, 2026-10-19): the first miss
# per (userId, pinnedLabel) per window warns fleet-wide (Redis NX) + files one
# github_label_fallback loop-metric row; later misses fall back silently. The 24 h
# default keeps any rolling 24 h window at ≤2 rows (below the log-signal sweep's
# RULE 1 bar of 3 distinct hours). 0 = legacy every-miss warn. Empty/unset = default.
#GITHUB_LABEL_FALLBACK_WARN_MS=86400000
# (07c1d554) Dead-client Google refresh: the retry latch stays process-local
# (GOOGLE_REFRESH_DISABLED_CLIENT_LATCH_MS, default 6 h — each process stops
# hammering Google) but its ERROR/metric EMISSION is gated by a Redis NX key
# per userId (default 24 h) so the whole web+worker+box fleet writes ONE
# error row per user per day — a process-local emission latch minted 35
# rows/13 hours on 2026-10-18 from two dead-client users alone. A suppressed
# arm writes a google_refresh_latch_suppressed loop-metric row (invisible to
# the log-signal sweep). 0 = legacy every-window emission. Empty/unset = default.
#GOOGLE_REFRESH_LATCH_WARN_MS=86400000
# Shared secret for backend → github-mcp container (generate strong random key)
GITHUB_MCP_API_KEY=your-github-mcp-api-key-here
# Internal Docker URL (backend → github-mcp container via Docker network)
GITHUB_MCP_URL=http://github-mcp-prod:8000/mcp

# ── X (Twitter) OAuth 2.0 PKCE + MCP integration (optional) ───────────────────
# Create an X App at: https://developer.x.com → Projects & Apps → your App
#   User authentication settings:
#     Type: OAuth 2.0 (Confidential client)
#     App permissions: Read and write and Direct message
#     Callback URLs: https://digby.ai/api/crossmodel/x/callback,
#                    http://localhost:4000/api/crossmodel/x/callback
X_OAUTH_CLIENT_ID=your-x-oauth2-client-id
X_OAUTH_CLIENT_SECRET=your-x-oauth2-client-secret
X_OAUTH_REDIRECT_URI=https://digby.ai/api/crossmodel/x/callback
# Generate with: openssl rand -hex 32   (must be exactly 64 hex chars / 32 bytes)
X_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-64-chars-total
# Shared secret for backend → x-mcp container
X_MCP_API_KEY=your-x-mcp-api-key
X_MCP_URL=http://x-mcp-prod:8000/mcp
# App-only bearer token (optional, currently unused — kept for future read fallback)
X_BEARER_TOKEN=AAAAAAAA...

# ── Discord MCP integration (optional — shared bot, no per-user OAuth) ─────────
# Create a Discord application at: https://discord.com/developers/applications
#   → New Application → Bot → Reset Token (that token IS DISCORD_BOT_TOKEN)
#   → Privileged Gateway Intents: MESSAGE CONTENT ON (read tools need it)
#   → Invite the bot: OAuth2 → URL Generator → scope=bot, permissions=
#     Read Messages/View Channels + Read Message History + Send Messages (3072)
# DISCORD_BOT_TOKEN lives ONLY in the discord-mcp container (docker-compose.base.yml);
# the backend never sees it. Compose passes it from the host env.
DISCORD_BOT_TOKEN=your-discord-bot-token-here
# Shared secret for backend → discord-mcp container (generate strong random key)
DISCORD_MCP_API_KEY=your-discord-mcp-api-key
# Internal Docker URL (backend → discord-mcp container via Docker network)
DISCORD_MCP_URL=http://discord-mcp-prod:8000/mcp

# macOS iMessage bridge agent (optional — feature is dark until a Mac is paired)
IMESSAGE_AGENT_API_URL=https://digby.ai/api          # base URL the Mac agent dials home to
IMESSAGE_AGENT_DOWNLOAD_URL=https://github.com/example-org/crossmodel/tree/main/imessage-agent

# AI — Frontier Models: NONE (owner 2026-09-22). Every model call runs on an
# admin-editable SEAT (Account → Admin → Endpoints → Model roles) whose built-in
# defaults are the four open-model providers below. The OpenAI / xAI / Google /
# Anthropic keys are no longer read by any code path; leave them unset.

# AI — Open Source models (all direct provider APIs)
DEEPSEEK_API_KEY=sk-...          # DeepSeek V4.1 Flash (`deepseek-flash`) — api.deepseek.com: Double Checker, Computer-use vision default, utility primary leg
ZAI_API_KEY=...                  # GLM-5.3 (Triple Checker, coding, Browser agent) + glm-5.3-flash (Image reader + PDF reader OCR defaults) + glm-image / cogview-4-250304 (Image generator fallback legs) — api.z.ai international endpoint, key format id.secret
MOONSHOT_API_KEY=sk-...          # Kimi K3 (Digby lead, supervisors, the built-in vision upgrade) — api.moonshot.ai
DASHSCOPE_API_KEY=sk-...         # Alibaba DashScope intl — embeddings (text-embedding-v4), rerank (qwen3-rerank), qwen3.6-27b helper/utility safety net, qwen3.6-flash (Digby Kids), qwen3-tts-flash (text-to-speech), qwen3-asr-flash (speech-to-text fallback leg), qwen-image-3.0 (Image generator default) + qwen-image-2.0 / z-image-turbo / wan2.7-image
# DASHSCOPE_UTILITY_MODEL=qwen3.6-27b  # optional — utility/background fallback model (default qwen3.6-27b; DeepSeek V4.1 Flash stays primary)

# Image generation (2026-09-24) — the Image generator seat (Account → Admin →
# Endpoints → Model roles; default qwen-image-3.0 on DASHSCOPE_API_KEY, chain
# z-image-turbo → glm-image → cogview-4-250304 on ZAI_API_KEY; or any registered
# endpoint model flagged [image]). Spend caps for the generate_image tool and
# POST /api/crossmodel/images/generate — Redis counters, refunded when the
# provider call fails. Defaults: 8 per chat per hour, 40 per user per day
# (≈ $1.20/day/user at $0.03). The 100-file / 200 MB generated-files quota
# still applies on top.
# IMAGE_CHAT_HOURLY_CAP=8
# IMAGE_USER_DAILY_CAP=40
# Implicit edit legs (2026-09-25): when the SEATED chain has no edit-capable leg
# (a z-image-turbo / glm-image / cogview-4-250304 head), a reference image is
# still edited natively on the same-key qwen-image-2.0 → wan2.7-image →
# qwen-image-3.0 legs (the receipt / loop_metrics image_generation row carries
# editLegSource 'fallback'). Kill switch — set 1 to restore describe-only for
# that case (the Image reader describes the reference and the text-only head
# generates from the description; referenceMode 'described'). Never affects a
# pinned `spec` (the admin Test button) or an instance without DASHSCOPE_API_KEY.
HF_API_KEY=hf_...

# AI — Embeddings + Rerank: DashScope (above). COHERE_API_KEY is no longer read.

# Web Search
MCP_DIGBY_TOKEN=...
# Gateway URL override — self-hosted instances point this at their own
# brightdata-mcp container (e.g. http://brightdata-mcp:8000/mcp). Unset =
# production default https://mcp.digby.ai/mcp.
# MCP_DIGBY_URL=
# MCP_DIGBY_HEALTH_URL=   # optional; derived from MCP_DIGBY_URL by default

# Cookie Secure override — self-hosted instances on plain-http LAN (no TLS)
# set COOKIE_SECURE=false so browsers store the auth cookies. Unset =
# NODE_ENV-driven (secure in production).
# COOKIE_SECURE=

# Speech-to-Text (chat voice notes + youtube_pipe audio fallback)
# Self-hosted open-source STT: NVIDIA Parakeet-TDT-0.6B-v3 (CC-BY-4.0) via
# achetronic/parakeet — OpenAI-compatible /v1/audio/transcriptions, CPU-only
# (the `stt` service in docker-compose.base.yml; prod reaches it at
# http://admin-stt-prod:5092/v1). When STT_BASE_URL is UNSET the backend uses
# DashScope qwen3-asr-flash (DASHSCOPE_API_KEY; ≤5 min of audio per request —
# no frontier whisper leg since 2026-09-22); when set but unreachable it falls back to
# Whisper-1 automatically. NOTE: the URL must END IN /v1 — the client appends
# /audio/transcriptions.
# This env chain is the BUILT-IN ASR default; admins can instead point the
# "speech-to-text (ASR)" model role (Account → Admin → Endpoints) at any
# registered custom-endpoint model — the override wins when set, and a failing
# override falls back to this env chain (never hard-fails transcription).
# STT_BASE_URL=http://localhost:5092/v1
# STT_API_KEY=            # only if the STT server enforces a bearer key
# STT_MODEL=whisper-1     # request field only — the server runs its baked-in model
# youtube_pipe slow path: yt-dlp binary for audio download (baked into the prod
# backend image together with Deno, its required JS runtime since 2025-11).
# YTDLP_PATH=yt-dlp

# Digby Code — optional dedicated cross-origin preview host (unlocks full SPA
# previews). Leave BOTH unset for the default same-origin, token-safe preview.
# Must match; NEXT_PUBLIC_* is baked into the frontend build. See docs/DIGBY_CODE.md.
# CODING_PREVIEW_HOST=preview.digby.ai
# NEXT_PUBLIC_CODING_PREVIEW_HOST=preview.digby.ai

# ── Gate flip 2026-09-11 (owner: "get the framework back operating at full steam") ──
# Every gate that blocked, withheld, replaced or staged owner-confirmations on a
# machine lane's OWN work is now OBSERVE-ONLY / default-OFF: the detection still
# runs and records loop_metrics (guard_strike/guard_miss rows carry meta.outcome
# 'observed'), but nothing is bounced, refused or paged. Set the OPT-IN below =1
# to re-arm a specific gate. Credential scans, destructive-action confirmations
# and the deterministic self-merge artifact gates (G1 pr_state / G2 ci / G4
# secret_scan) were NOT flipped. Canonical table: AGENTS.md §Gate defaults.
# EVIDENCE_GUARD_ENFORCE=1         # re-arm the evidence guard's conviction pipeline on machine
#                                  # finals (in-loop reject-back + finalize REDACT/REPLACE +
#                                  # mishap tickets/alarms). Unset = original final delivered
#                                  # with the guard's notes appended; verdict rows still recorded.
# QUOTE_GUARD_ENFORCE=1            # GUARD 4 fabricated_quote convicts again (needs the above to
#                                  # actually replace). Unset = '[UNVERIFIED QUOTED OUTPUT]' note only.
# CLAIMS_BLOCK_ORIGIN_VOUCH_DISABLED=1  # Typed claims-block push/file_change entries verify ONLY via
#                                  # harness receipts again. Unset = an unreceipted hex-sha entry whose
#                                  # commit the guard's GitHub re-query confirms PRESENT on origin
#                                  # verifies via 'origin' (the Framework Operator charter's raw-shell
#                                  # publish path leaves only run_command receipts, which carry no
#                                  # sha); a 404 stays a conviction, an unreachable API lands
#                                  # unverifiable (advisory).
# DELETED 2026-11-03 (RSW-1 delete-with-ledger cluster 37, goal 393f731e): was
#   COMMIT_LOCAL_CLAIM_GUARD_DISABLED=1 - NF_INERT (0 compose/Dockerfile hits, 0 bracket access), reader removed.
#   The A1 receipt split is UNCONDITIONAL now: a git_commit receipt is LOCAL and never exonerate
#   a push claim (it never id-matches commit_pushed / commit_local, is excluded from the coarse
#   external-action tier, and its sha never rides the origin re-query as receipt-confirmed), the
#   commit_local claim kind ('banked/committed <sha>') always mines, and the cross-chat
#   get_run_receipts git_push lane is always on. No behaviour change: the switch was unset in every
#   build, so production already ran the split arm. Restoring the pre-split matcher would need a code
#   change, not an env var - do NOT re-add this key.
#                                  # round again. Unset = accepted + guard_strike zero_tool_prefinal
#                                  # {outcome:observed} (this gate fired on 252/253 supervisor wakes).
# OUTBOUND_CLAIM_AUDIT_ENFORCE=1   # refuse/annotate machine send_chat_message / todo / goal /
#                                  # ticket text again. Unset = dispatch byte-identical + metric
#                                  # (outcome observed_refusable / observed_annotatable).
# RUN_DEADLINE_ENABLED=1           # machine coding runs get the soft wall-clock deadline
#                                  # max(20 min, 0.8× cadence) again. Unset = no deadline (maxSteps,
#                                  # per-call timeouts, lease + zombie stop bound the run).
#                                  # (RUN_DEADLINE_DISABLED RETIRED.) Chat/supervisor/cross-checker
#                                  # profile deadlines are untouched latency contracts.
#                                  # to numeric/hex/path tokens in machine finals again. Unset =
#                                  # finals delivered verbatim; detector reports observedLines
#                                  # (guard_strike seam numeric_provenance, outcome observed,
#                                  # markedLines 0). (…_DISABLED RETIRED.)
# (WORK_TOOLS_NO_CARD_DISABLED RETIRED — RSW-1; the card-free direct path is unconditional.)
#                                  # Default: the user's own message IS the authorization — on a human
#                                  # turn (userTurnAt set, trigger not machine) start_coding_session /
#                                  # configure_workspace / import_repo / create_feed, and schedule_message /
#                                  # update / cancel / pause / resume_schedule on THIS chat execute at once
#                                  # (staging-time validation still runs first; loop_metrics
#                                  # work_tool_direct {tool, origin:'human', surface}); the tool result tells
#                                  # the model progress shows on the task card. Machine turns (schedule /
#                                  # hook / agent / webhook) and external-effect tools (send_chat_message,
#                                  # share links, autonomy, members, webhooks, send_to_instance,
#                                  # dispatch_platform_task, control tools) card exactly as before
#                                  # (platform/work-tools.ts is the table). A Dig-deeper rung
#                                  # (ToolContext.escalation) cards too — it re-runs an earlier ask.
#                                  # A schedule armed / edited / cancelled on the direct path is
#                                  # stamped MODEL-authored (promptSetBy / initiator 'machine').
# MACHINE_SCHEDULE_CONFIRM_GATE=1  # stage confirmation cards for machine-run schedule_message /
#                                  # update_schedule / cancel_schedule again. Unset = executes when
#                                  # the target is in own scope (own chat / family / same-owner
#                                  # fleet sibling); foreign-owner + send_to_instance still stage.
#                                  # G19 now accepts the unique 8-char schedule-id prefix the tools invite.
# DIRECTIVE_CONFLICT_ENFORCE=1     # refuse a machine update_schedule prompt rewrite that contradicts
#                                  # an open owner decision again. Unset = rewrite APPLIES with a
#                                  # [DIRECTIVE NOTICE] line (6/6 refusals were owner status questions).
#                                  # again (41 supervisor self-wakes). Unset = self-loops suppressed.
#                                  # (HOOK_ALARM_SELFLOOP_DISABLED RETIRED.)
#                                  # (400) and force:true is refused (403) again. Unset = lands +
#                                  # loop_metric todo_close_no_evidence. (TODO_EVIDENCE_DISABLED RETIRED.)
# STOPPED_SCHEDULE_CARDS=1         # file 'Resume the stopped schedule X?' owner cards again.
#                                  # Unset = the detection log line only (its metric was removed
#                                  # by S-2 2026-10-08 — unread; 7 cards,
#                                  # 4 owner clicks, 0 resumes).
# ── Schedule self-re-arming governor (finding B2, 2026-09-27 — canlaw watch 7fbd168c renewed
#    itself 8× via renewOnExhaustion: 125 runs, 0 commits, $77). Machine/system recurring rows on
#    LANE chats only; owner rows + supervisor chats exempt; every lookup error renews (fail-open).
# RENEW_MAX_GENERATIONS=3          # unattended successor renewals allowed per chain (generation is
#                                  # derived from the renewedFromId chain; 0 = refuse every one).
#                                  # A refusal posts the 🛑 stop note with the reason, makes the
#                                  # schedule_disabled event alarm-class again (no successorId) and
#                                  # writes loop_metric schedule_renew_refused {outcome:'refused'}.
# RENEW_ANCHOR_CHECK_ENFORCE=1     # make the open-anchor rule REFUSE (generation ≥ 1 rows on a project
#                                  # with no active/blocked goal, no LIVE register_watched_resource row
#                                  # and no register_artifact row awaiting verify_durable). Unset =
#                                  # OBSERVE-ONLY: the successor still arms, the row is written with
#                                  # {outcome:'observed'} (gate-flip doctrine 2026-09-11).
#                                  # will do at exhaustion (config-only "auto-renew is ON" wording again).
#                                  # the owner briefing head, the board digest and the Status card.
# (2026-10-04) ACTION_VERIFIER_ENFORCE=1 also restores the USER-VISIBLE correction row on human chats (default: observe-only — ticket only)
# ACTION_VERIFIER_ENFORCE=1        # supervisor machine-wake action verifier strikes again: remove
#                                  # "phantom claim" lines + ONE reject-back re-orchestration.
#                                  # Unset = ACTION-class verdict recorded (guard_strike
#                                  # machine_wake_reject_back outcome observed), note delivered
#                                  # unmodified (all 9 ids it struck on 2026-09-11 were real lane
#                                  # messages the supervisor had read). NOTE (ticket b216475a,
#                                  # 2026-09-13): DETERMINISTIC strikes — citation-class (msg/sched/
#                                  # session/ticket row-existence) + the future-observation clock —
#                                  # are ENFORCED even unset (guard_strike machine_wake_citation_enforce
#                                  # outcome enforced): existence arithmetic, false-positive-safe.
# BUSY_SKIP_ALARM_HOOK=1           # wake the supervisor via attention_needed on busy-skip streaks
#                                  # again (from 10 skips). Unset = the busy-skip warn log line (metric removed by S-2 2026-10-08).
#                                   # (default defers it to the claiming coding worker — cross-box fix)
# BLANK_SELFHEAL_DISABLED=1        # (FO 2026-09-23) disable the coding worker's fresh-blank-session
#                                   # self-heal (worktreePath set, dir absent, zero completed runs)
#                                   # — restores the legacy hard "Workspace missing on disk" error
#                                  # (3 consecutive probe errors → one attention_needed + lastStatus
#                                  # 'alarm:delta_gate_errors'). Fail-open firing is unaffected; the
#                                  # per-error metric was removed by S-2 2026-10-08 — the hook alarm is the signal.
#                                  # blank-worktree provisioning (default defers it to the claiming
#                                  # coding worker — the cross-box fix)
# BLANK_SELFHEAL_DISABLED=1        # (FO 2026-09-23, tickets 002542b1/f4f128c0) disable the coding
#                                  # worker's fresh-blank-session self-heal (worktreePath set, dir
#                                  # absent, zero completed runs) — restores the legacy hard
#                                  # "Workspace missing on disk" error

# Coding-autonomy remediation P1 kill-switches (2026-09-08) — all default OFF
# (feature active). Set =1 to disable the specific behavior:
# DERAIL_RUN_END_DISABLED=1        # keep withholding forever instead of ending a run
#                                  # after wrong-tool trips on 2 different tools / 3 total
#                                  # derail state a MACHINE run enqueues ONE durable continuation
#                                  # wake to its own chat carrying the intended next step verbatim
#                                  # (re-ground rules + goal context). Unset = active; set = the
#                                  # terminal end stands alone (pre-fix behavior).
# DERAIL_RESCUE_MAX_PER_DAY=2      # per-chat continuation budget per 24 h (Redis counter,
#                                  # stamped only on a real enqueue) — a rescue chain dies here.
# DERAIL_INTENT_DISCOUNT_DISABLED=1 # 2026-09-24 (ticket 0625bf62): disarm the ARMED
#                                  # intent-mismatch discount in the success-side wrong-tool
#                                  # guard — ordered/pre-computed narration mismatches on
#                                  # PLATFORM tools (schedule_get, archive_chat …) are then
#                                  # counted/steered/tripped again (the 2026-09-22..23
#                                  # measure-only behavior). Unset = armed. The measurement
#                                  # guard_miss rows log either way.
# DERAIL_INTENT_DISCOUNT_CAP=25    # 2026-09-24 (ticket 0625bf62): per-tool per-run ceiling on
#                                  # ARMED discount applications — past the cap the classic
#                                  # 2c98b460 count/steer/trip ladder owns the tool again
#                                  # (mutating archive/move/rename have no volume-cap owner).
# DERAIL_BATCH_SIBLING_DISABLED=1  # 2026-09-24 (ticket f6217896): disarm the batch-sibling
#                                  # acquittal — when the SAME dispatched batch emitted the
#                                  # convicted "intended" tool as its own call (the itemized
#                                  # multi-tool checklist shape), the sibling read_file calls
#                                  # are aligned batch work, not wrong-tool substitution.
#                                  # Unset = acquit + log guard_miss reason 'batch_sibling';
#                                  # =1 restores the classic conviction ladder.
# OVERSIZE_SHRINK_RETRY_DISABLED=1 # don't shrink largest tool results on a provider
#                                  # size-class (400/413) rejection — retry identical payload
#                                  # owner-question answers / supervisor directives at persist
# ── Secret scrubbing D4 (2026-09-27; platform/secret-scan.ts) ──
#                                  # shape from every redaction (the structured provider patterns —
#                                  # incl. the new Z.ai id.secret shape — still redact; the commit gate never had it).
#                                  # The shape is narrowed (review fix): cursor labels (next_token, page_token,
#                                  # csrf_token, cancellation token …) are exempt, the value needs an entropy
#                                  # signal (mixed case + digit, or >=24 mostly-alnum chars that are not joined
#                                  # prose words) and stops at & and \ — placeholders and URL tails survive.
#                                  # INBOUND_SECRET_SCAN_DISABLED above also covers the update_supervisor_state
#                                  # and flag_owner_question write seams (directive text/evidence, dispatch
#                                  # notes, project statuses, notes; question + context).
#                                  # list_chats.lastMessage output on MACHINE runs (ctx.machineTriggered OR no
#                                  # user-turn anchor; default ON: a pasted key in a lane message rode a
#                                  # supervisor harvest read into a stored directive)
# CHAT_READ_SECRET_REDACT_ALL=1    # widen the chat-read redaction to user-present turns too (default:
#                                  # a human turn reads its own chats verbatim)
# ── Secrets hygiene T6 / T7 (2026-09-28; backlog audit) ──
#                                  # letters, spaced 4x4 or contiguous, redacted only when `app password` /
#                                  # `gmail` / `smtp` / `secret` sits within 160 chars) from every
#                                  # redaction. Redaction-only — never the commit gate. Existing row:
#                                  # scripts/framework-audit/redact-owner-question-answer.js (dry-run default).
#                                  # default: message / stack / cmd / stderr / stdout have every URL
#                                  # userinfo (`https://x-access-token:<token>@…`) masked to `//***@`
#                                  # before any caller can log it (execFile echoes the argv).
#                                  # scrubCredentials format: message, stack and metadata string leaves
#                                  # of EVERY record lose URL-embedded credentials before the console +
#                                  # app_error_logs transports). Existing rows:
#                                  # scripts/framework-audit/scrub-error-log-credentials.js (dry-run default).
#                                  # when one guard seam strikes >=3 sessions / 60 min. Unset =
#                                  # detection recorded as loop_metric seam_alarm only.
#                                  # (SEAM_ALARM_DISABLED is RETIRED — no longer read.)

# AGENT_TRANSIENT_BACKOFF_MS=10000,30000,60000
#                                  # retry-lane backoff table (ms per attempt) for transient
#                                  # model-call rejections (429/5xx/network + post-4251dcb3 the
#                                  # spurious in-budget 400 class). Overrides EVERY trigger class
#                                  # EXACTLY (no jitter). Test suites set "1,1,1"; production
#                                  # should never set this. Unset = class defaults (ticket
#                                  # cffaa701): user-turn runs 10s/30s/60s; unattended runs
#                                  # (machine-triggered / helper fast-seat) 10s/30s/60s/120s/240s
#                                  # with ±25% jitter, one attempt per table entry.
# AGENT_TRANSIENT_BACKOFF_MACHINE_MS=10000,30000,60000,120000,240000
#                                  # overrides ONLY the unattended-run default table (exact, no
#                                  # jitter). Ignored when AGENT_TRANSIENT_BACKOFF_MS is set.
# AGENT_TRANSIENT_RETRY_AFTER_CAP_MS=600000
#                                  # ceiling on an honored provider Retry-After header (the
#                                  # transient lane raises its wait to the header value, never
#                                  # above this cap). Default 600000 (10 min).
# CONTINUATION_PROVIDER_THROTTLE_DELAY_MS=180000
#                                  # EXACT delay (ms) for a continuation wake whose previous run
#                                  # was killed by an exhausted provider transient lane
#                                  # (429/5xx). Unset = 180000 + 0–120s jitter (3–5 min), so the
#                                  # wake lands past the throttle window instead of re-dying in
#                                  # it (the ~45s fast-lane default re-entered the still-limited
#                                  # window — six canlegal-bench deaths in ~1.5h, cffaa701).

# Coding-autonomy remediation P5 publish-path kill-switches (2026-09-09) — all
# default OFF (feature active). Set =1 to disable the specific behavior:
# BASE_PUSH_GUARD_ENFORCE=1         # OPT-IN (gate flip 2026-09-11): refuse machine-run pushes
#                                   # to the BASE branch again. Unset = the push executes with a
#                                   # receipt note + guard_strike {seam:base_push, observed}.
#                                   # (BASE_PUSH_GUARD_DISABLED is RETIRED.)
# RUN_COMMAND_PUSH_GUARD_ENFORCE=1  # OPT-IN: refuse raw-shell `git push`/`gh pr merge`/REST-merge
#                                   # on machine runs again. Unset = a [publish-intent notice]
#                                   # + metric, then the command runs. The x-access-token remote
#                                   # persistence shape is ALWAYS refused on machine runs.
#                                   # (RUN_COMMAND_PUSH_GUARD_DISABLED is RETIRED.)
# PUSH_CI_OBSERVE_ENABLED=1         # OPT-IN: the ONE bounded post-push CI poll on git_push /
#                                   # open_pull_request (30s sleep + Checks query). Unset = off;
#                                   # check_ci + the G2 self-merge gate are unaffected.
#                                   # (PUSH_CI_OBSERVE_DISABLED is RETIRED.)
# PUSH_CI_OBSERVE_DELAY_MS=30000    # wait before that single CI query (tests set 0)
# VERIFY_SHA_GATE_DISABLED=1        # PR gate: skip the verify-staleness comparison
#                                   # (content fingerprint vs verify-time fingerprint)
# UNVERIFIED_GATE_ENFORCE=1         # OPT-IN: block open_pull_request on an UNVERIFIED chain
#                                   # (stages skipped, tool not installed) again. Unset = the
#                                   # PR opens with a NOTE + guard_strike {seam:unverified_pr_gate}.
#                                   # (UNVERIFIED_GATE_DISABLED is RETIRED.)
# PR_DOCS_ONLY_BYPASS_DISABLED=1    # A5 (2026-09-27): open_pull_request skips the verify chain when every
#                                   # file the PR carries (branch vs merge-base ∪ dirty tree) is under docs/
#                                   # or *.md, and the PR body says "docs-only … unverified by design".
#                                   # Set 1 = docs-only PRs go through auto-verify like any other diff.
# [DELETED 2026-11-12 — RSW-1] PR_GATE_AUTO_VERIFY_DISABLED. The auto-verify arm
#                                   # is unconditional now: on an unpassed / STALE verify state open_pull_request
#                                   # RUNS the chain itself and opens on green (red still refuses, with the
#                                   # failing stage's tail). A lane that wants the old plain refusal runs
#                                   # `verify` itself first. Telemetry either way: guard_strike
#                                   # {seam: pr_gate_docs_only | pr_gate_auto_verify, state: observed,
#                                   # outcome: observed} — both seams are EXCLUDED from the same-seam alarm
#                                   # (they fire on every relieved PR by construction).
# PR_GATE_AUTO_VERIFY_DEADLINE_MS=720000  # review fix 2026-09-27: the in-tool auto-verify (verify-slot queue
#                                   # wait + chain) gives up after this many ms — default 12 min, clamped
#                                   # ≤ 14 min, i.e. under the agent loop's 15-min TOOL hard abort, which
#                                   # does NOT cancel the tool (an auto-verify that outlived it would have
#                                   # pushed + opened a PR after the model was told "aborted"). On expiry
#                                   # the tool REFUSES pointing at `verify`; nothing is pushed or opened;
#                                   # the chain finishes in the background and records its result. Row:
#                                   # {seam: pr_gate_auto_verify, verdict: timeout, timedOut, deadlineMs}.
