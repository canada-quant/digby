# Hardening loop iteration 10 (2026-09-24)
# COMPACTION_FIRST_USER_CLIP_EXEMPT_DISABLED=1   # kill switch: the run's FIRST user message (a 20–27k-char supervisor wake) is clipped to 14k on every compaction again
# RUN_CLAIM_TXN_MAX_WAIT_MS=10000                # worker claim transaction pool wait (Prisma default 2 s lost claim ticks during deploy drains)
# ZOMBIE_RUN_STOP_CONFIRM_MISSES=2               # ticket 65af5656: how many CONSECUTIVE zero-touch lease heartbeats must confirm the agent_runs row is really ABSENT before the executor cancels a zombie run. The heartbeat's count is rows RUNNING NOW, not rows that EXIST, so a single 0 (a racing finalize, a status flip, a pool hiccup) must never kill a live lane; a row that still exists under another status always stands down regardless. Min 1 (1 = the pre-65af5656 single-strike behaviour), default 2 (~2.5 min grace against a ~90 min runaway hazard).
# RUN_CLAIM_TXN_TIMEOUT_MS=30000                 # worker claim transaction timeout
# LOCAL_MIRROR_SELFHEAL_DISABLED=1               # kill switch: a 'local' project whose bare mirror vanished fails fast instead of re-initing it at session start
# Future-observation-clock guard — estimate/deadline-governed forward clocks
# ("~6:20 PM PDT", "Verdict by ~11:45 AM PDT") are exempt from the impossible-
# observation strike in BOTH guard lanes (operator iteration 11, 2026-09-25).
# Set to 1 to restore the old conviction.
# ESTIMATE_CLOCK_EXEMPT_DISABLED=1

# Future-observation-clock guard, iteration 13 (FO firing 25, 2026-09-25): a
# forward clock whose instant matches an ENABLED coding_schedules.nextRunAt
# within ±60s is a paraphrased FIRING TIME ("next tick 11:30Z", a digest ETA
# cell), not an invented observation — exempt in BOTH guard lanes (the chat
# lane fetches the instants itself; the coding lane gets them injected from
# run-executor). Set to 1 to restore the conviction.
# SCHED_CLOCK_EXEMPT_DISABLED=1

# Future-observation-clock guard, iteration 13b (supervisor steer 12:19Z,
# 2026-09-25): a line LEADING with "After <EVENT>:" is a forward plan, never
# an observation ("After TRAIN_DONE: comparator package → … 11:30Z") — exempt
# in BOTH guard lanes, with a completed-work-verb-anywhere-on-the-line
# anti-smuggle bound. Set to 1 to restore the conviction.
# AFTER_EVENT_CUE_DISABLED=1

