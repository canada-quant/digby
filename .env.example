# FLEET-PS-FIRST (supervisor SOTA round 2, 2026-10-20 — project supervisors handle their own projects first):
# HOOK_FLEET_ALARM_PS_FIRST_DISABLED=1        # a PS-covered project's run_failed / attention_needed / goal_blocked / schedule_disabled / schedule_near_cap / schedule_cap_skipped reach the Fleet Supervisor at once again (no 45-min held [PS ESCALATION] for alarms, no shed of the two cadence signals; rows already held are no longer revalidated and deliver by their retryAt with the neutral prompt)
# FLEET_DIFF_PS_COVERED_EXCLUDE_DISABLED=1    # the Fleet Supervisor's [SINCE YOUR LAST WAKE] lists PS-covered projects' progress (runs finished, artifacts, progress-tier todo closes, schedule firings) again
# FLEET_BOARD_GOAL_PACE_DISABLED=1            # the fleet [BOARD] is counts-only again (no per-project top-goal / pace / KPI / last-move line)
# HARNESS-RECEIPTS-AND-CLAIMS (supervisor SOTA round 3, 2026-10-20 — what a wake did, from the harness record):
# SUPERVISOR_HARNESS_RECEIPTS_DISABLED=1      # supervisor wake notes keep the model-typed ACTIONS TAKEN block (no 'ACTIONS TAKEN (harness):' / 'WAKE: no-op (harness: 0 lane actions)' append, no metadata.harnessActions, classifiers read the markers only, the wake-close doctrine + sweep prompts ask the model to copy receipt ids again, guard-chrome redaction stops at a harness appendix again)
# SUPERVISOR_FOLLOWTHROUGH_QUIET_ZERO_DISABLED=1  # an answer-first FOLLOW-THROUGH round of an owner turn on a supervisor chat closes a zero-action result with 'WAKE: no-op (harness: 0 lane actions)' again (default: the owner-ask reply's neutral 'Harness record:' line, note classified as a plain note — executed actions list under 'ACTIONS TAKEN (harness):' either way); =1 also keeps a round's own trailing 'WAKE: no-op' close line, drops the round brief's "not a wake — never close it with WAKE: no-op" sentence and stops the content classifier (harnessLineKind / classifySupervisorNote) reading the 'Harness record:' line as a plain note (2026-10-22 minors), and a reply made only of harness record lines counts as an owner-ask reply again (isNoopOnlyReply)
# RUN_OUTCOME_CLAIMS_LINE_DISABLED=1          # run_completed digests drop the front-loaded 'CLAIMS: n receipted · m unverified (type ref: reason)' line built from the run's finish_run check (no finish_run call ⇒ 'CLAIMS: not checked …')
# GUARD_CHROME_SIGNAL_KEEP_DISABLED=1         # a stripped guard trailer leaves no advisory '[System note: the harness could not match tool evidence for N claim(s) …]' line in model context / get_chat_messages (pre-2026-10-20 silent strip)
# ARCHIVED_TARGET_RETIRE_DISABLED=1           # machine work aimed at an ARCHIVED chat is refused at every firing again (no sweeper pause / restore re-arm, no arm refusals, no owner-answer re-route, no todo unassign, no orphaned watchdog item; refusal row surface = coding|plain), pre-2026-10-20
# LANE LIFECYCLE C (2026-10-21 — idle lanes retire themselves; platform/lane-retire.ts, platform.service archiveChat, coding.controller, run-reaper):
# LANE_IDLE_RETIRE_DISABLED=1                 # the R6 retire scan is observe-only again (no archive, no coding-lane walk) and keys on the charter STAMP (a lane whose charter todo is done is never a candidate); project discovery back to 50 projects / 30 d, unordered; a restore writes no restore marker only when ARCHIVE_CASCADE_DISABLED=1 and TICKET_LANE_ARCHIVE_GAPS_DISABLED=1 are set too (the machine cascade and the ticket drain read it); supervisor duty 5 carries the pre-C5 auto-archive sentence
# ARCHIVE_CASCADE_DISABLED=1                  # archiving a chat no longer archives its idle children (a machine archive's children otherwise pass the root's rules: proof, restore marker, 14-d human window, share link, pinned title, inbound integration, owning ticket, an open charter, the caller's own idle bar (lane-retire 7 d, the idle archiver its N days, the reaper 7 d / 6 h) — in the parent's folder, ≤ 50 or the caller's pass-wide budget; the owner's own archive keeps a pinned / shared / integration-wired / other-folder child, and archive_chat on a supervisor chat cascades as a machine archive), and a restore no longer brings back the children a cascade took; a user turn's dispatch heal clears archivedAt directly again (not through archiveChat)
# SESSION_API_ARCHIVE_STAMP_DISABLED=1        # PATCH /coding/sessions/:id {archived:true} flips only the satellite again (the chat keeps its sidebar visibility; no archivedAt stamp), and {archived:false} clears archivedAt directly again (not through archiveChat — no cascade restore)
# REAPER_CANDIDATE_ROTATION_DISABLED=1        # run-reaper rules (e)/(h) read the old candidate pages (no archived / schedule filter, (e) unordered, (h) oldest first, no id cursor)
#                                             # (third review 2026-10-22: rules (e)/(h) also skip a child carrying the lane-lifecycle RESTORE MARKER — read whenever
#                                             #  any marker reader is on, i.e. unless LANE_IDLE_RETIRE_DISABLED + ARCHIVE_CASCADE_DISABLED + TICKET_LANE_ARCHIVE_GAPS_DISABLED
#                                             #  are all set — and a reaper pass shares ONE cascade budget of 25 children, each child idle the rule's own bar.)
#                                             # All seven lane-lifecycle switches (these four + DISPLAY_PARENT_NESTING_DISABLED, TICKET_LANE_ARCHIVE_GAPS_DISABLED,
#                                             # BRANCH_JANITOR_EXTENDED_RULES_DISABLED) read through ONE parser: ON for 1 / true / on.
# CREDENTIAL_REPLY_WAKE_DISABLED=1            # owner WORDS typed on a credential-gated card answer credential_pending again (red toast, transcript note only, the asking lane is NOT woken) — pre-2026-10-20
# SCHEDULE_GET_DIRECT_LOOKUP_DISABLED=1       # schedule_get resolves only from its listing window again
# MARKDOWN_WALL_REPAIR_DISABLED=1             # no re-lining of answers whose newlines arrived as spaces (server persist)
# NEXT_PUBLIC_MARKDOWN_WALL_REPAIR_DISABLED=1 # (frontend BUILD arg) same, live render
# PROGRESS_NOTE_LONG_DISABLED=1               # goal / todo progressNote stored ≤ 200 chars again (default 2,000; displays clamp to 200 either way) — ticket a8d6e514
# DEFERRAL_CADENCE_EXEMPT_DISABLED=1          # supervisor_deferral_unarmed counts "Next sweep: …" labels and cited-schedule lines again — ticket fcee0741
# FIX_STATE_BOX_ANCESTRY_DISABLED=1           # closure-manifest / fix-state proof accepts only a box on the fix sha or main head again (not a box on a descendant of the fix)
# FEEDBACK_FIX_STATE_FALLBACK_TOKEN_DISABLED=1 # fix-state's merged ∧ deployed proof rides ONLY the ticket owner's GitHub token again (no lane-home-owner fallback — ticket b165cfdb; the nightly suite's tokenless bench-account tickets go back to fixLive=false)
# FIX_STATE_EVIDENCE_REPO_ALLOWLIST=example-org/optcg # ticket cf5f9718 — repos a machine close may name in evidence.repo (comma-separated owner/name); unset = the platform repo only (a named repo is then refused REPO NOT ALLOWED with zero GitHub reads)
# FIX_STATE_EVIDENCE_REPO_DISABLED=1 # ticket cf5f9718 kill switch — evidence.repo is ignored again; every fix-state GitHub read targets the platform repo
# ── Frontier only by reflection (2026-10-06 late; owner: "pickers should never choose frontier … only … reflection"; AGENTS.md bullet) ──
# AUTO_PICK_FRONTIER_ENABLED=1                # the ONLY way back to frontier auto-picks (roster C-1); a stored autoPickPolicy='all' is ignored without it
# FRONTIER_REFLECTION_COUNCIL_DISABLED=1      # no reflect note / consult_frontier_council; repeated failures keep only the Double-Checker consult
# FRONTIER_COUNCIL_MAX_PER_RUN=2              # councils per run (1..4; a new window needs 2 more failures)
# FRONTIER_COUNCIL_SESSION_DAILY_CAP=6        # councils per session per UTC day (1..50; Redis — down ⇒ only the per-run cap)
# FRONTIER_COUNCIL_TIMEOUT_MS=120000          # per-advisor timeout (15 s..300 s)
# FRONTIER_COUNCIL_MAX_TOKENS=16384           # per-advisor max output
# FRONTIER_COUNCIL_IGNORE_STEPS=2             # steps the agent may ignore the reflect note before the harness runs the council itself
# FRONTIER_COUNCIL_REASONING_EFFORT=high      # low | medium | high
# ── Admin seat Test budget for custom endpoints (2026-10-07; AGENTS.md "SEAT TEST BUDGET" bullet) ──
# ROLE_TEST_CUSTOM_TIMEOUT_MS=55000           # Test / verify probes of a <label>:<model> seat (clamped 20–58 s — the ALB idle timeout is 60 s); built-ins keep 20 s
# ROLE_TEST_CUSTOM_TIMEOUT_DISABLED=1         # every probe back to 20 s
# ── Image-generator seat Test budget (2026-10-10, ticket 61d33af9) ──
# IMAGE_PROBE_TIMEOUT_MS=180000              # the image seat's Test / detect probe budget (clamped 55 s–300 s). Real self-hosted image backends take ~118 s at the OpenAI Images default shape (15.4 s fixed + ~5.1 s/step × 20); the Test DELIVERS over the /admin/model-roles/test/stream SSE route (keepalives every 15 s) so the ALB's 60 s idle timeout cannot cut it. The agent tool test_model_role caps at 190 s overall. A per-model imageTimeoutMs (below) raises this probe budget with it.
# IMAGE_PROBE_TIMEOUT_DISABLED=1             # the image probe back to the legacy 55 s (built-in legs AND custom legs at stock timeouts; a per-model imageTimeoutMs still raises its own leg)
# IMAGE_CUSTOM_TIMEOUT_MS=300000               # (04c8ffd1) per-request timeout for EVERY custom-registry image leg, clamped [120000, 720000]. Slow local image backends (Qwen-Image behind LiteLLM, 5-10 min/generation) need 300000-600000; a per-model value on the endpoint entry (imageTimeoutMs) wins over this. Built-in providers are unaffected. (99b5545d) A custom endpoint that answers the submit with HTTP 202 + a job id is POLLED — GET {base}/images/jobs/{jobId} (or the 202 body's status_url / Location header) every 2 s, each poll a fresh ≤30 s request — until the job completes, fails, or the whole-call budget above runs out; no request ever hangs (Cloudflare's ~100 s proxy cut never fires on a poll loop). The bearer key rides a poll ONLY to the submit endpoint's own origin (explicit cross-origin status URLs are polled unauthenticated); 3 consecutive unparseable status bodies bail with a provider error instead of spinning; a 202 with an inline image (no job id) still delivers sync-style.
# ── First-party visitor analytics (2026-10-07; backend crossmodel/visitors/; AGENTS.md "FIRST-PARTY VISITOR ANALYTICS" bullet) ──
# VISITOR_ANALYTICS_DISABLED=1                # POST /visit-events answers 204 and stores nothing; no server events
# VISITOR_HASH_SECRET=                        # HMAC key for the visitor IP hash (default: derived from JWT_SECRET with a fixed label); changing it re-keys every hash
# VISIT_EVENTS_RETENTION_DAYS=400             # visit_events older than this are deleted by the visitor-analytics cron (min 30)
# SPEND_ROLLUP_DISABLED=1                     # no spend_daily_rollups (the "all time" per-user cost window)
# NEXT_PUBLIC_VISITOR_ANALYTICS_DISABLED=1    # (frontend BUILD arg) no client capture (visitor id, first / last touch, page events)
# ── Client UI error capture (2026-11-06, ticket d4e643a5; backend crossmodel/client-errors/, frontend lib/client-error-reporter.ts) ──
# Before this, NOTHING captured a client-side failure: no window.onerror, no unhandledrejection, no React componentDidCatch and no
# ingest endpoint — app_error_logs (written only by the backend winston transport) could not hold one, so the hourly
# log-signal-sweep was structurally blind to a render crash. The browser now posts a scrubbed, bounded report (quoted user text
# masked as <text>, credential shapes → ***, URL reduced to origin+pathname) to POST /api/crossmodel/client-error, which writes
# through the SAME logger with source 'client-error' so the EXISTING sweep auto-files it — there is no second filer.
# Volume is bounded in code, not by env: one row per signature per 5 min, 12/client/min, 30/process/min, 400/process/day.
# CLIENT_ERROR_INGEST_DISABLED=1              # POST /client-error answers 204 and records nothing (server side)
# NEXT_PUBLIC_CLIENT_ERROR_REPORT_DISABLED=1  # (frontend BUILD arg) installs no listeners, posts nothing (browser side)
# QUOTA_TRUSTED_PROXY_HOPS=2                  # ALB + nginx: the client IP is the XFF entry 2 from the right (unforgeable) — used by the guest deep-research quota AND the visitor IP hash; unset = the first XFF entry (header-writable)
# ── User-added MCP servers (2026-10-06, ticket e294f9a4; backend user-mcp/; AGENTS.md "USER-ADDED MCP SERVERS" bullet) ──
# USER_MCP_DISABLED=1                         # kill switch: /mcp-servers routes 404, no mcp_* tools offered, health cron no-ops
# USER_MCP_HEALTH_DISABLED=1                  # stop the background re-probe only (cron user-mcp-health)
# USER_MCP_MAX_SERVERS=10                     # servers per user
# USER_MCP_MAX_TOOLS_PER_SERVER=40            # tools offered per server
# USER_MCP_MAX_TOOLS_TOTAL=80                 # tools offered across all of a user's servers
# USER_MCP_CALL_TIMEOUT_MS=60000              # one tools/call
# USER_MCP_PROBE_TIMEOUT_MS=15000             # one initialize + tools/list probe
# USER_MCP_RESULT_MAX_CHARS=30000             # tool result cap
# USER_MCP_HEALTH_INTERVAL_MIN=30             # re-check interval for a healthy server (failing: 5 min → 6 h backoff)
# USER_MCP_ALLOW_PRIVATE_HOSTS=1              # EDGE / LAN ONLY: allow private / internal hosts (never set on the cloud)
# USER_MCP_ALLOW_HTTP=1                       # EDGE / LAN ONLY: allow plain http (the token would travel unencrypted)
# ── Nightly-suite fixes (2026-10-06, ticket ccd634fb; AGENTS.md "NIGHTLY-SUITE FIXES" bullet) ──
# MEMORY_REMEMBER_LIFTS_REJECTION_DISABLED=1  # a forget-ban outlives an explicit remember again; "favourite" is a scrub word again
# CHAT_RULE_UNSAVED_RETRY_DISABLED=1          # no one-time re-run when a standing chat rule was acknowledged but not saved
# BROWSER_READONLY_BANNER_ON_NEED_DISABLED=1  # the INTERACTION UNAVAILABLE banner on every read-only cloud browser session again
# ── Web tickets K1 (2026-10-06; AGENTS.md "WEB TICKETS (K1" bullet) ──
# NEXT_PUBLIC_GOOGLE_ANALYTICS_DISABLED=1     # (frontend BUILD arg) the Google tag configures the Ads ids only — no GA4
# DELETED 2026-10-30 (RSW-1 delete-with-ledger, goal 393f731e): was
#                                             # NEXT_PUBLIC_CODING_FEEDBACK_DISABLED=1 — NF_INERT (0 compose/Dockerfile hits), reader removed; persisted assistant rows always carry the action row
# FEEDBACK_MESSAGE_LINK_CHECK_DISABLED=1      # POST /feedback links the message id as sent (a non-row id 500s on the FK again)
# ── Background delegation (2026-10-06; coding/background-delegation.ts; AGENTS.md "Background delegation" bullet) ──
# DELEGATE_BACKGROUND_DISABLED=1              # delegate/delegate_parallel schemas + guidance byte-identical to before; background:true runs in the foreground with a note
# DELEGATE_BACKGROUND_MAX=3                   # background workers running at once per run (1..6)
# DELEGATE_BACKGROUND_END_WAIT_MS=120000      # a finished lead waits this long (total) for running workers, then takes one more turn (0..600000)
# DELEGATE_STATUS_MAX_WAIT_MS=120000          # ceiling on delegate_status wait_seconds (0..600000)
# DELEGATE_BACKGROUND_LATE_POST_DELAY_MS=5000 # grace before a late report posts below the final answer (0..60000)
# ── Integration prefetch deadline (2026-10-10, ticket 11d98377; integration-context.ts) ──
# INTEGRATION_PREFETCH_DEADLINE_MS=45000      # the controller's integration prefetch is BOUNDED (it sits before the run
                                              # starts, so a wedged leg was first-word latency on every lane); ≤ 0 = the
                                              # unbounded pre-fix wait (the nightly suite's Quick-lane 49.7 s breach)
# ── Hosted hardened browser (ticket ea3ad8a8; browser-service/ + docker-compose.base.yml) ──
# One pinned Chromium (mcr.microsoft.com/playwright:v1.55.1-noble), per-session
# Playwright CONTEXTS with persisted cookies/localStorage — the "saved cache /
# VM-style" browser for users with NO paired desktop agent. The service is
# built and started by every deploy; with NO secret it runs INERT (health-green,
# every action 401 — it never crash-loops a deploy wave). The backend routes
# to it only when BOTH are set:
# BROWSER_SERVICE_ENABLED=1              # staged rollout master switch (default off)
# BROWSER_SERVICE_SECRET=<random 32+>    # REQUIRED when enabled — must be IDENTICAL in
#                                        # backend + worker + browser-service (per-session
#                                        # HMAC tokens derive from it on both sides).
# Optional tuning:
# BROWSER_SERVICE_URL=http://browser-service:3100
# BROWSER_CONTEXTS_MAX=16                # total live contexts (LRU-evicted at the cap)
# BROWSER_CONTEXT_IDLE_MS=900000         # idle context reap (15 min default)

# ── Interactive CLOUD browser (BrightData Scraping Browser) — ticket 5f69fdc4 ──
# Default OFF. The cloud browser is otherwise READ-ONLY (navigate + read a page,
# no clicks/typing). Set to 1 to let the cloud driver hold ONE live browser per
# MCP session on the gateway's stateful /browser/mcp mount (the stateless shared
# /mcp stays read-only for x-mcp and the scrape tools — unaffected by this flag).
# Only turn this on where the gateway is session-stateful AND the BrightData
# zone's IP allowlist includes the box's egress IP; otherwise every CDP attempt
# falls back to scrape and the capability reads 'zone-blocked'.
# In production do NOT hand-edit /opt/crossmodel/.env on a box: deploy.yml
# rewrites that file wholesale on every wave. The flag is plumbed from the
# CLOUD_BROWSER_CDP repo secret; empty/unset renders '' which the driver reads
# as off, so leaving the secret unset changes no behaviour.
# CLOUD_BROWSER_CDP=1

# ── Invalid-token spike detector baseline class (2026-10-14 FO retune; backend/src/middleware/auth-signal.ts) ──
# AUTH_SIGNAL_BASELINE_IPS=10.0.0.12,10.0.0.13   # comma-separated baseline IPs (they fire their one-per-window spike
                                                    # line only at the tripwire); empty/whitespace = UNSET → the default
                                                    # pair (NEVER means "none" — the docker-compose `${VAR:-}` pass-through
                                                    # hands containers '' for a host-unset var); explicit token 'none' =
                                                    # NO baseline IPs
# AUTH_SIGNAL_BASELINE_SPIKE_THRESHOLD=300          # integer tripwire for baseline IPs; NaN/garbage/non-positive → 300
# AUTH_SIGNAL_BASELINE_DISABLED=1                   # kill switch: every IP is non-baseline (full pre-retune behavior)

