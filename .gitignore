# Dependencies
node_modules/
# Bare form too: a node_modules SYMLINK is a file, which the trailing-slash
# pattern does not match — that is how PR #285 accidentally committed one.
node_modules
.pnp
.pnp.js

# Testing
coverage/

# Production
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
# Canada migration runtime state (AWS resource IDs, no secrets)
scripts/canada-migration/state.env
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Feedback ticket screenshots decoded to disk (e87aee19) — runtime data, never source
backend/uploads/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# macOS build outputs (build-pkg.sh / build-app.sh write here; the PUBLISHED copies
# that ship are frontend/public/DigbyAgent.pkg and frontend/public/Digby.dmg, tracked)
/DigbyAgent.pkg
/Digby.dmg

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Prisma
prisma/migrations/**/migration.sql

# Docker
*.env.docker

# Misc
.turbo
.cache
tmp/
temp/

# Autopilot logs
logs/autopilot/*.log
logs/*.log
backend/.env.test.migrate

# Durable jest worker tmp root (backend/jest.global-setup.js)
backend/.jest-tmp/

# Next.js incremental type-check state (regenerated by every tsc run)
frontend/tsconfig.tsbuildinfo

# Python bytecode (scripts/e2e tooling)
__pycache__/
*.pyc

# FO/Mac-ops scratch: local SSH/install helpers + tarballs (never commit; may embed credentials)
scratch/
qs-artifact/

# Cloudflare Argo Tunnel origin credential (legacy, unused) + any TLS material
# Never commit: certs, keys or tunnel tokens.
cert.pem
*.pem
*.key
