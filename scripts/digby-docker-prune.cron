# Digby production docker cleanup cron
# -------------------------------------------------------------------
# Installed on prod EC2 (203.0.113.21) at /etc/cron.d/digby-docker-prune
# on 2026-04-20 after discovering the disk was at 80% (39/49 GB) with
# 25.42 GB of reclaimable build cache. At the time every deploy rebuilt
# images via `docker compose build --no-cache`, piling up layers in the
# buildkit cache indefinitely. Builds are layer-cached now (CI since
# 2026-08-31, PR #572; manual scripts since 2026-09-17, oq_65027a53) but
# cached builds still accumulate deltas, so this prune stays.
#
# This cron prevents the disk from filling up again by running a
# lightweight daily prune plus a heavy weekly builder-cache prune.
#
# Install / reinstall:
#   scp scripts/digby-docker-prune.cron ubuntu@203.0.113.21:/tmp/
#   ssh ubuntu@203.0.113.21 \
#     'sudo install -m 644 -o root -g root /tmp/digby-docker-prune.cron /etc/cron.d/digby-docker-prune'
#
# Tail log:
#   ssh ubuntu@203.0.113.21 'sudo tail -f /var/log/docker-prune.log'
#
# Note: Autopilot EC2 (203.0.113.23) already has an equivalent cron
# in paul's crontab:  0 3 * * 0 docker system prune -f ...
# -------------------------------------------------------------------

# DAILY at 04:00 UTC: light prune (unused containers, networks, dangling images)
0 4 * * * root docker container prune -f > /var/log/docker-prune.log 2>&1; docker image prune -f >> /var/log/docker-prune.log 2>&1; docker network prune -f >> /var/log/docker-prune.log 2>&1

# WEEKLY Sunday 04:15 UTC: heavy prune (build cache older than 48h)
15 4 * * 0 root docker builder prune -af --filter "until=48h" >> /var/log/docker-prune.log 2>&1; echo "---$(date -u)---" >> /var/log/docker-prune.log
