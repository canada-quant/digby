<Project Sdk="Microsoft.NET.Sdk">

  <!-- Digby Windows shell (W2) — a WebView2 host wrapping https://digby.ai/crossmodel.
       The Windows port of macos-app/Sources/Digby/main.swift. Self-contained
       single-file publish for win-x64; the only dependency is Microsoft.Web.WebView2
       (the WebView2 runtime itself ships with Windows 10/11 via Edge). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Digby.Shell</RootNamespace>
    <AssemblyName>Digby.Shell</AssemblyName>

    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>Digby</Product>
    <Description>Digby for Windows — the desktop shell around digby.ai</Description>

    <!-- App icon (embedded in the exe; also feeds the tray icon + shortcuts). -->
    <ApplicationIcon>digby.ico</ApplicationIcon>

    <!-- Self-contained single-file publish (win-x64). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- No ICU dependency; WinForms is fine with invariant globalization. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- PerMonitorV2 DPI awareness — applied by the generated
         ApplicationConfiguration.Initialize() in Program.cs. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- Travels with the published exe — the tray icon loads it from disk at
         runtime (the window icon is ALSO embedded via ApplicationIcon).
         ExcludeFromSingleFile keeps it a REAL file beside the single-file exe
         (bundled content files are not extractable at runtime); if the copy
         is absent the shell falls back to the exe's embedded icon
         (MainForm.LoadIconBestEffort), so this is belt-and-braces, never fatal. -->
    <Content Include="digby.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
